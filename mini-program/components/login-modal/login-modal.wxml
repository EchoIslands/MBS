<view class="login-mask" wx:if="{{visible}}" catchtap="onMaskTap">
  <view class="login-dialog" catchtap="onDialogTap">
    <view class="login-close" catchtap="onClose">
      <mbs-icon name="close" size="28" color="var(--text-tertiary)" />
    </view>

    <view class="login-brand">
      <view class="login-avatar">
        <mbs-icon name="user" size="48" color="var(--primary)" />
      </view>
      <view class="login-title">顾客登录</view>
      <view class="login-hint">登录后可预约服务、查看排队进度</view>
    </view>

    <view class="login-field">
      <view class="login-input-wrap">
        <mbs-icon name="phone" size="32" color="var(--text-tertiary)" />
        <input
          class="login-input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>
    </view>

    <view class="login-hint" wx:if="{{setupRequired}}">首次使用，请设置六位数字密码。</view>
    <view class="login-field"><view class="login-input-wrap"><input class="login-input" password="{{true}}" type="number" maxlength="6" placeholder="{{setupRequired ? '设置六位数字密码' : '六位数字密码'}}" value="{{password}}" bindinput="onPasswordInput" /></view></view>
    <view class="login-field" wx:if="{{setupRequired}}"><view class="login-input-wrap"><input class="login-input" password="{{true}}" type="number" maxlength="6" placeholder="确认密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" /></view></view>
    <view class="login-hint">忘记密码？请联系门店重置，重置密码为手机号后六位。</view>
    <view class="login-error" wx:if="{{error}}">{{error}}</view>

    <view class="login-submit-btn {{loggingIn ? 'login-submit-btn-disabled' : ''}}" catchtap="onLogin">
      <mbs-icon wx:if="{{!loggingIn}}" name="phone" size="32" color="#ffffff" />
      <text>{{loggingIn ? '处理中...' : (setupRequired ? '设置密码并登录' : '立即登录')}}</text>
    </view>
  </view>
</view>
