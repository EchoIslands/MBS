<view class="screen"><view class="card">
  <view class="title">设置或修改密码</view>
  <view class="hint">验证手机号后可设置新密码。也可以直接用验证码登录。</view>
  <input type="number" maxlength="11" placeholder="本人手机号" value="{{phone}}" data-field="phone" disabled="{{saving || sending}}" bindinput="onInput" />
  <input type="number" maxlength="6" placeholder="六位短信验证码" value="{{code}}" data-field="code" disabled="{{saving || sending}}" bindinput="onInput" />
  <button class="logout" loading="{{sending}}" disabled="{{saving || sending}}" bindtap="onSendCode">获取验证码</button>
  <input password type="text" maxlength="6" placeholder="新六位数字密码" value="{{newPassword}}" data-field="newPassword" disabled="{{saving || sending}}" bindinput="onInput" />
  <input password type="text" maxlength="6" placeholder="再次输入新密码" value="{{confirmPassword}}" data-field="confirmPassword" disabled="{{saving || sending}}" bindinput="onInput" />
  <view class="hint" wx:if="{{notice}}">{{notice}}</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <button class="submit" loading="{{saving}}" disabled="{{saving || sending}}" bindtap="onSubmit">保存新密码并登录</button>
  <button class="logout" disabled="{{saving || sending}}" bindtap="onBackToLogin">返回验证码登录</button>
</view></view>
