<view class="screen"><view class="card">
  <view class="title">为了账户安全，请修改密码</view>
  <view class="hint">请先修改初始密码，再使用其他功能。修改密码后，线上支付仍需门店确认顾客本人。</view>
  <input password type="number" maxlength="6" placeholder="原六位数字密码" value="{{currentPassword}}" data-field="currentPassword" bindinput="onInput" />
  <input password type="number" maxlength="6" placeholder="新六位数字密码" value="{{newPassword}}" data-field="newPassword" bindinput="onInput" />
  <input password type="number" maxlength="6" placeholder="再次输入新密码" value="{{confirmPassword}}" data-field="confirmPassword" bindinput="onInput" />
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <button class="submit" loading="{{saving}}" disabled="{{saving}}" bindtap="onSubmit">保存新密码</button>
  <view class="hint">忘记密码？请联系门店重置。</view>
  <button class="logout" bindtap="onLogout">退出登录</button>
</view></view>
