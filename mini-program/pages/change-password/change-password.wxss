.screen{min-height:100vh;background:#eff6ff;padding:80rpx 32rpx;box-sizing:border-box}.card{background:#fff;border-radius:32rpx;padding:40rpx}.title{font-size:40rpx;font-weight:700;color:#1f2937}.hint{font-size:26rpx;color:#6b7280;line-height:1.7;margin:24rpx 0}input{border:1rpx solid #d1d5db;border-radius:20rpx;padding:24rpx;margin:24rpx 0;font-size:30rpx}.submit{background:#2563eb;color:white;border-radius:20rpx}.error{color:#dc2626;font-size:26rpx;margin:20rpx 0}.logout{background:white;color:#6b7280;font-size:28rpx;margin-top:20rpx}
