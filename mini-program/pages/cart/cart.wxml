<wxs src="../../utils/format.wxs" module="fmt" />
<view class="cart-page">
  <view class="cart-header">
    <view class="header-back" bindtap="goBack">
      <mbs-icon name="arrowLeft" size="36" color="var(--text-primary)" />
    </view>
    <view class="header-title">购物车</view>
    <view class="header-spacer"></view>
  </view>

  <view wx:if="{{displayCart.length === 0}}" class="cart-empty">
    <mbs-icon name="shoppingBag" size="96" color="var(--text-tertiary)" />
    <view class="empty-text">购物车是空的</view>
    <view class="btn btn-secondary" bindtap="goToProducts">去逛逛</view>
  </view>

  <block wx:if="{{displayCart.length > 0}}">
    <view class="container cart-container">
      <!-- 全选 -->
      <view class="cart-select-all card">
        <view class="select-row" bindtap="onSelectAllTap">
          <view class="select-box {{allSelected ? 'select-box-active' : ''}}">
            <mbs-icon wx:if="{{allSelected}}" name="checkCircle" size="32" color="#fff" />
          </view>
          <text class="select-label">全选</text>
        </view>
        <view class="clear-btn" bindtap="onClearCart">清空购物车</view>
      </view>

      <!-- 商品列表 -->
      <view class="cart-list">
        <view wx:for="{{displayCart}}" wx:key="id" class="cart-item card">
          <view class="select-box {{item.selected ? 'select-box-active' : ''}}" data-item-id="{{item.id}}" bindtap="onToggleSelect">
            <mbs-icon wx:if="{{item.selected}}" name="checkCircle" size="32" color="#fff" />
          </view>
          <image wx:if="{{item.product.images && item.product.images.length > 0}}" class="cart-item-image" src="{{item.product.images[0]}}" mode="aspectFill" />
          <view wx:else class="cart-item-image-placeholder">
            <mbs-icon name="shoppingBag" size="48" color="var(--text-tertiary)" />
          </view>
          <view class="cart-item-info">
            <view class="cart-item-top">
              <view class="cart-item-name">{{item.product.name}}</view>
              <view class="cart-item-remove" data-item-id="{{item.id}}" bindtap="onRemove">
                <mbs-icon name="trash2" size="32" color="var(--text-tertiary)" />
              </view>
            </view>
            <view class="cart-item-price-row">
              <text class="cart-item-price">¥{{fmt.formatMoney(item.memberPrice)}}</text>
              <text wx:if="{{item.memberPrice < item.product.price}}" class="cart-item-original">¥{{fmt.formatMoney(item.product.price)}}</text>
            </view>
            <view class="cart-item-bottom">
              <text class="cart-item-subtotal">小计: ¥{{fmt.formatMoney(item.subtotal)}}</text>
              <view class="quantity-control">
                <view class="quantity-btn" data-item="{{item}}" bindtap="onQuantityMinus">
                  <mbs-icon name="minus" size="24" color="var(--text-primary)" />
                </view>
                <text class="quantity-value">{{item.quantity}}</text>
                <view class="quantity-btn" data-item="{{item}}" bindtap="onQuantityPlus">
                  <mbs-icon name="plus" size="24" color="var(--text-primary)" />
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 优惠券选择 -->
    <view wx:if="{{selectedItems.length > 0}}" class="cart-coupon-bar" bindtap="toggleCouponModal">
      <view class="coupon-bar-left">
        <mbs-icon name="ticket" size="32" color="var(--accent)" />
        <text class="coupon-bar-label">{{selectedCouponName || '选择优惠券'}}</text>
      </view>
      <view class="coupon-bar-right">
        <text wx:if="{{couponDiscount > 0}}" class="coupon-bar-discount">-¥{{couponDiscount}}</text>
        <text class="coupon-bar-tip">{{selectedCouponId ? '更换' : (customerCoupons.length > 0 ? customerCoupons.length + ' 张可用' : '无可用')}}</text>
        <mbs-icon name="arrowLeft" size="28" color="var(--text-tertiary)" class="coupon-bar-arrow" />
      </view>
    </view>

    <!-- 底部结算栏 -->
    <view class="cart-footer">
      <view class="cart-payment">
        <radio-group class="payment-group" bindchange="onPaymentChange">
          <label class="payment-option">
            <radio value="balance" checked="{{paymentMethod === 'balance'}}" color="var(--primary)" />
            <text class="payment-label">余额支付</text>
          </label>
          <label class="payment-option">
            <radio value="store_pickup" checked="{{paymentMethod === 'store_pickup'}}" color="var(--primary)" />
            <text class="payment-label">到店自提付款</text>
          </label>
        </radio-group>
      </view>
      <view style="display: flex; align-items: center; justify-content: space-between;">
        <view class="cart-total">
          <text class="total-label">合计:</text>
          <text class="total-price">¥{{payablePrice}}</text>
          <text wx:if="{{couponDiscount > 0}}" class="total-discount">已优惠 ¥{{couponDiscount}}</text>
          <text class="total-count">已选{{selectedItems.length}}件</text>
        </view>
        <view
          class="checkout-btn {{selectedItems.length === 0 || submitting ? 'checkout-btn-disabled' : ''}}"
          bindtap="onCheckout"
        >
          <text wx:if="{{submitting}}">提交中...</text>
          <text wx:else>结算({{selectedItems.length}})</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 优惠券选择弹窗 -->
  <view wx:if="{{showCouponModal}}" class="coupon-modal" bindtap="toggleCouponModal">
    <view class="coupon-modal-content" catchtap="noop">
      <view class="coupon-modal-header">
        <text class="coupon-modal-title">选择优惠券</text>
        <view class="coupon-modal-close" bindtap="toggleCouponModal">
          <mbs-icon name="x" size="36" color="var(--text-tertiary)" />
        </view>
      </view>
      <scroll-view scroll-y class="coupon-modal-body">
        <view wx:if="{{customerCoupons.length === 0}}" class="coupon-empty">
          <mbs-icon name="ticket" size="80" color="var(--text-tertiary)" />
          <text class="coupon-empty-text">暂无可用优惠券</text>
        </view>
        <block wx:else>
          <view class="coupon-option {{selectedCouponId ? '' : 'coupon-option-active'}}" bindtap="onClearCoupon">
            <text class="coupon-option-name">不使用优惠券</text>
            <text wx:if="{{!selectedCouponId}}" class="coupon-option-checked">已选</text>
          </view>
          <view
            wx:for="{{customerCoupons}}"
            wx:key="id"
            data-coupon-id="{{item.id}}"
            class="coupon-option {{selectedCouponId === item.id ? 'coupon-option-active' : ''}} {{isCouponApplicable(item.coupon) ? '' : 'coupon-option-disabled'}}"
            bindtap="onSelectCoupon"
          >
            <view class="coupon-option-info">
              <text class="coupon-option-name">{{item.coupon.name || '优惠券'}}</text>
              <view class="coupon-option-desc">
                <text wx:if="{{item.coupon.type === 'fixed_amount'}}" class="coupon-option-value">¥{{item.coupon.value}}</text>
                <text wx:if="{{item.coupon.type === 'percentage'}}" class="coupon-option-value">{{item.coupon.value}}折</text>
                <text wx:if="{{item.coupon.type === 'buy_x_get_y'}}" class="coupon-option-value">买赠券</text>
                <text wx:if="{{item.coupon.minOrderAmount}}" class="coupon-option-threshold">满{{item.coupon.minOrderAmount}}元可用</text>
              </view>
              <view class="coupon-option-scope">
                <text wx:if="{{item.coupon.applicableScope === 'all'}}">全场通用</text>
                <text wx:if="{{item.coupon.applicableScope === 'product'}}">限定商品</text>
                <text wx:if="{{item.coupon.applicableScope === 'service'}}">仅限服务</text>
                <text class="coupon-option-expire">有效期至 {{item.coupon.endAt}}</text>
              </view>
              <view wx:if="{{!isCouponApplicable(item.coupon)}}" class="coupon-option-reason">
                <text wx:if="{{item.coupon.type === 'buy_x_get_y'}}">买赠券暂不可用</text>
                <text wx:elif="{{item.coupon.applicableScope === 'service'}}">仅限服务类项目</text>
                <text wx:elif="{{totalPrice < (item.coupon.minOrderAmount || 0)}}">订单金额未满使用门槛</text>
                <text wx:else>不适用当前商品</text>
              </view>
            </view>
            <view wx:if="{{selectedCouponId === item.id}}" class="coupon-option-check">
              <mbs-icon name="checkCircle" size="36" color="var(--accent)" />
            </view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <login-modal visible="{{showLogin}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
