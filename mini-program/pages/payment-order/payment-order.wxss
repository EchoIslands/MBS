.order-page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; background: #f7f8fa; color: #1f2937; }
.card { margin-bottom: 24rpx; padding: 30rpx; background: #fff; border-radius: 24rpx; }
.state { padding: 60rpx 24rpx; text-align: center; color: #6b7280; font-size: 28rpx; }
.error { color: #b91c1c; line-height: 1.6; }
.status { color: #166534; font-size: 30rpx; font-weight: 600; }
.amount { margin: 20rpx 0; color: #f97316; font-size: 54rpx; font-weight: 700; }
.heading { margin-bottom: 22rpx; font-size: 30rpx; font-weight: 600; }
.item { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 18rpx; font-size: 26rpx; }
.item-name { flex: 1; min-width: 0; word-break: break-all; }
.row { margin-bottom: 26rpx; font-size: 25rpx; line-height: 1.6; }
.row text { display: block; word-break: break-all; }
.row text:first-child { color: #6b7280; margin-bottom: 6rpx; }
.note { font-size: 23rpx; color: #6b7280; line-height: 1.6; }
.primary, .secondary { margin: 24rpx 0; font-size: 28rpx; border-radius: 16rpx; }
.primary { color: #fff; background: #f97316; }
.secondary { color: #374151; background: #fff; }
