<view class="login-page">
  <view class="login-card">
    <view class="login-brand">
      <view class="login-avatar"><mbs-icon name="user" size="48" color="var(--primary)" /></view>
      <view class="login-title">顾客登录</view>
      <view class="login-hint">登录后可预约服务、查看会员权益</view>
    </view>
    <view class="login-modes">
      <view class="login-mode {{loginMode === 'password' ? 'selected' : ''}}" data-mode="password" bindtap="setLoginMode">密码登录</view>
      <view class="login-mode {{loginMode === 'sms' ? 'selected' : ''}}" data-mode="sms" bindtap="setLoginMode">短信验证码登录</view>
    </view>
    <view class="login-field"><view class="login-input-wrap">
      <input class="login-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view></view>
    <block wx:if="{{loginMode === 'password'}}">
      <view class="login-hint" wx:if="{{setupRequired}}">首次使用，请设置六位数字密码。</view>
      <view class="login-field"><view class="login-input-wrap">
        <input class="login-input" password="{{!showPassword}}" type="number" maxlength="6" placeholder="{{setupRequired ? '设置六位数字密码' : '六位数字密码'}}" value="{{password}}" bindinput="onPasswordInput" />
        <button class="password-toggle" size="mini" aria-label="{{showPassword ? '隐藏密码' : '显示密码'}}" bindtap="togglePasswordVisibility" hover-class="password-toggle-active">
          <image class="password-visibility-icon" src="/assets/icons/{{showPassword ? 'eye' : 'eye-off'}}.png" mode="aspectFit" aria-hidden="true" />
        </button>
      </view></view>
      <view class="login-field" wx:if="{{setupRequired}}"><view class="login-input-wrap">
        <input class="login-input" password="{{!showConfirmPassword}}" type="number" maxlength="6" placeholder="确认密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
        <button class="password-toggle" size="mini" aria-label="{{showConfirmPassword ? '隐藏确认密码' : '显示确认密码'}}" bindtap="toggleConfirmPasswordVisibility" hover-class="password-toggle-active">
          <image class="password-visibility-icon" src="/assets/icons/{{showConfirmPassword ? 'eye' : 'eye-off'}}.png" mode="aspectFit" aria-hidden="true" />
        </button>
      </view></view>
      <view class="login-hint">忘记密码？请联系门店重置，重置密码为手机号后六位。</view>
    </block>
    <block wx:else>
      <view class="login-field"><view class="login-input-wrap">
        <input class="login-input" type="number" maxlength="6" placeholder="请输入六位短信验证码" value="{{smsCode}}" bindinput="onSmsCodeInput" bindfocus="onSmsCodeFocus" />
        <button class="sms-paste" size="mini" bindtap="onPasteSmsCode">粘贴</button>
      </view></view>
      <button class="sms-send" disabled="{{smsSending || smsSeconds > 0 || loggingIn}}" bindtap="onSendSmsCode">{{smsSending ? '发送中...' : (smsSeconds > 0 ? smsSeconds + ' 秒后重发' : '获取验证码')}}</button>
      <view class="login-hint">新用户验证手机号后自动注册，老用户直接登录。</view>
    </block>
    <checkbox-group bindchange="onRememberPhoneChange"><label class="login-hint"><checkbox value="remember" checked="{{rememberPhone}}" />记住手机号（不保存密码）</label></checkbox-group>
    <view class="login-error" wx:if="{{error}}">{{error}}</view>
    <view class="login-submit-btn {{loggingIn || restoringSession ? 'login-submit-btn-disabled' : ''}}" bindtap="onLogin">
      <text>{{restoringSession ? '正在自动登录...' : (loggingIn ? '处理中...' : (setupRequired ? '设置密码并登录' : '立即登录'))}}</text>
    </view>
  </view>
</view>
