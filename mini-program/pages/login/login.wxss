.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom, 0));
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 50%, #fff8f0 100%);
  box-sizing: border-box;
}

.login-card {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 56rpx 40rpx;
  box-shadow: 0 24rpx 64rpx rgba(245, 158, 11, 0.12);
  box-sizing: border-box;
}

.login-brand {
  text-align: center;
  margin-bottom: 48rpx;
}

.login-avatar {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #ffedd5, #fed7aa);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-title {
  font-size: 42rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.login-hint {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.login-field {
  margin-bottom: 28rpx;
}

.login-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  background: var(--gray-50);
  border: 2rpx solid var(--gray-200);
  border-radius: 24rpx;
  box-sizing: border-box;
}

.login-input {
  flex: 1;
  width: 0;
  min-width: 0;
  height: 92rpx;
  padding: 0 80rpx 0 0;
  box-sizing: border-box;
  font-size: 30rpx;
  color: var(--text-primary);
  background: transparent;
}

.login-input-wrap .password-toggle {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  min-height: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  line-height: 1;
  border: none;
  border-radius: 16rpx;
  background: transparent;
  color: var(--text-secondary);
}

.login-input-wrap .password-toggle::after { border: none; }
.login-input-wrap .password-toggle-active { background: var(--gray-200); }

.password-visibility-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.login-error {
  background: var(--red-100);
  color: var(--danger);
  font-size: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.login-submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 100rpx;
  margin-top: 32rpx;
  background: linear-gradient(135deg, #f97316, #ea580c);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 32rpx rgba(234, 88, 12, 0.2);
}

.login-submit-btn-disabled {
  opacity: 0.7;
}
