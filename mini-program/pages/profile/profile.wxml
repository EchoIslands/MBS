<wxs src="../../utils/format.wxs" module="fmt" />
<view class="profile-page {{tabTransitionClass}}" bindtouchstart="onTabSwipeStart" bindtouchend="onTabSwipeEnd" bindtouchcancel="onTabSwipeCancel">
  <!-- 1) 渐变 VIP 头部 -->
  <view wx:if="{{customer}}" class="{{vipHeaderClass}}">
    <view class="vip-decor vip-decor-1"></view>
    <view class="vip-decor vip-decor-2"></view>
    <view class="vip-decor vip-decor-3"></view>

    <view class="vip-header-inner">
      <!-- 基本信息行 -->
      <view class="vip-info-row">
        <view class="vip-info-left">
          <view class="vip-avatar">
            <image wx:if="{{customer.avatar}}" class="vip-avatar-image" src="{{customer.avatar}}" mode="aspectFill" />
            <mbs-icon wx:else name="user" size="44" color="rgba(255,255,255,0.9)" />
          </view>
          <view class="vip-identity">
            <view class="vip-name">{{customer.name || '顾客'}}</view>
            <view class="vip-phone">{{customer.phone || ''}}</view>
          </view>
        </view>
        <view class="vip-info-right">
          <view class="vip-badge">
            <mbs-icon name="crown" size="24" color="rgba(255,255,255,0.95)" />
            <text>{{fmt.getPurchaseVIPLabel(purchaseLevel)}}</text>
          </view>
          <view wx:if="{{storedLevel !== StoredValueLevel.NONE}}" class="vip-badge vip-badge-sub">
            <mbs-icon name="wallet" size="20" color="rgba(255,255,255,0.95)" />
            <text>{{fmt.getStoredValueLabel(storedLevel)}}</text>
          </view>
        </view>
      </view>
      <view class="profile-self-actions">
        <view class="profile-self-action" bindtap="openProfileEdit">编辑个人资料</view>
        <view class="profile-self-action profile-self-action-primary" bindtap="goToMembership">办理 / 续费会员</view>
      </view>

      <!-- 2) 折扣卡 -->
      <view class="vip-discount-card">
        <view class="vip-discount-label">
          <mbs-icon name="sparkles" size="24" color="rgba(255,255,255,0.9)" />
          您当前的消费折扣
        </view>
        <view class="vip-discount-value">{{fmt.formatDiscount(effectiveDiscount)}} 折</view>
        <view class="vip-discount-hint">
          <text wx:if="{{purchaseLevel !== PurchaseVIPLevel.REGULAR && storedLevel !== StoredValueLevel.NONE}}">{{fmt.getPurchaseVIPLabel(purchaseLevel)}} × {{fmt.getStoredValueLabel(storedLevel)}} 折上折</text>
          <text wx:elif="{{purchaseLevel !== PurchaseVIPLevel.REGULAR}}">已开通 {{fmt.getPurchaseVIPLabel(purchaseLevel)}}</text>
          <text wx:elif="{{storedLevel !== StoredValueLevel.NONE}}">已开通 {{fmt.getStoredValueLabel(storedLevel)}}</text>
          <text wx:else>开通会员享受专属折扣</text>
        </view>
      </view>

      <!-- 3) 4 列数据速览 -->
      <view class="vip-stats-grid">
        <view class="vip-stat-item">
          <view class="vip-stat-label">
            <mbs-icon name="wallet" size="20" color="rgba(255,255,255,0.85)" />
            储值余额
          </view>
          <view class="vip-stat-value">¥{{balance}}</view>
        </view>
        <view class="vip-stat-item">
          <view class="vip-stat-label">
            <mbs-icon name="gift" size="20" color="rgba(255,255,255,0.85)" />
            可消费余额
          </view>
          <view class="vip-stat-value">¥{{withdrawable}}</view>
        </view>
        <view class="vip-stat-item">
          <view class="vip-stat-label">
            <mbs-icon name="star" size="20" color="rgba(255,255,255,0.85)" />
            积分
          </view>
          <view class="vip-stat-value">{{points}}</view>
        </view>
        <view class="vip-stat-item">
          <view class="vip-stat-label">
            <mbs-icon name="award" size="20" color="rgba(255,255,255,0.85)" />
            累计消费
          </view>
          <view class="vip-stat-value">¥{{totalSpent}}</view>
        </view>
      </view>

      <!-- 4) VIP 到期提醒 -->
      <view wx:if="{{expiringSoon && customer.purchaseVIPExpiresAt}}" class="vip-alert vip-alert-yellow">
        <mbs-icon name="alertCircle" size="28" color="#92400e" />
        <text>您的 {{fmt.getPurchaseVIPLabel(purchaseLevel)}} 将于 {{fmt.formatShortDate(customer.purchaseVIPExpiresAt)}} 到期，请及时续费</text>
      </view>

      <!-- 储值到期提醒 -->
      <view wx:if="{{storedExpiringSoon && customer.storedValueExpiresAt}}" class="vip-alert vip-alert-orange">
        <mbs-icon name="alertCircle" size="28" color="#9a3412" />
        <text>您的 {{fmt.getStoredValueLabel(storedLevel)}} 将于 {{fmt.formatShortDate(customer.storedValueExpiresAt)}} 到期。到期前充值满额可延续储值福利</text>
      </view>

      <!-- 5) 股东会员专属 -->
      <view wx:if="{{customer.isStockholder}}" class="vip-stockholder">
        <view class="vip-stockholder-label">
          <mbs-icon name="gift" size="24" color="rgba(255,255,255,0.9)" />
          股东推荐收益
        </view>
        <view class="vip-stockholder-row">
          <view>
            <view class="vip-stockholder-value">¥{{customer.referralEarnings || 0}}</view>
            <view class="vip-stockholder-hint">已推荐客户到店 · 提成比例 {{(customer.referralBonusRate || 0.10) * 100}}%</view>
          </view>
          <view class="vip-stockholder-crown">
            <mbs-icon name="crown" size="80" color="rgba(255,255,255,0.35)" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{editVisible}}" class="modal-mask" catchtap="closeProfileEdit">
    <view class="modal-dialog profile-edit-dialog" catchtap="stopPropagation">
      <view class="modal-header"><view class="modal-title">编辑个人资料</view><view class="modal-close" bindtap="closeProfileEdit">×</view></view>
      <view class="profile-edit-body">
        <view class="profile-edit-avatar" bindtap="chooseProfileAvatar">
          <image wx:if="{{editAvatar}}" src="{{editAvatar}}" mode="aspectFill" />
          <mbs-icon wx:else name="user" size="42" color="#9f7058" />
        </view>
        <view class="profile-edit-avatar-hint" bindtap="chooseProfileAvatar">{{editAvatarUploading ? '上传中…' : '点击更换头像'}}</view>
        <view class="profile-edit-field"><text>称呼 / 昵称</text><input value="{{editName}}" maxlength="40" bindinput="onEditName" placeholder="请输入希望展示的称呼" /></view>
        <view class="profile-edit-field"><text>性别（选填）</text><picker range="{{genderOptions}}" bindchange="onEditGender"><view class="profile-edit-choice">{{editGender === 'male' ? '男' : editGender === 'female' ? '女' : editGender === 'other' ? '其他' : '不展示'}}</view></picker></view>
        <view class="profile-edit-field"><text>生日（选填）</text><picker mode="date" value="{{editBirthday}}" end="{{editBirthdayMax}}" bindchange="onEditBirthday"><view class="profile-edit-choice">{{editBirthday || '请选择生日'}}</view></picker></view>
        <view class="profile-edit-note">登录手机号：{{customer.phone}}（如需更换请联系门店核实）</view>
        <button class="profile-edit-save" loading="{{editSaving}}" disabled="{{editSaving || editAvatarUploading}}" bindtap="saveProfileEdit">保存资料</button>
      </view>
    </view>
  </view>

  <!-- 未登录占位 -->
  <view wx:if="{{!customer && !loading}}" class="container">
    <view class="card login-placeholder-card">
      <view class="login-placeholder">
        <view class="login-placeholder-avatar">
          <mbs-icon name="user" size="56" color="var(--primary)" />
        </view>
        <view class="placeholder-title">登录后查看个人资料</view>
        <view class="placeholder-hint">登录后可预约服务、查看个人订单和积分余额</view>
      </view>
    </view>
  </view>

  <!-- 主内容区 -->
  <view wx:if="{{customer}}" class="container profile-content">

    <!-- 股东会员权益说明卡 -->
    <view wx:if="{{stockholderSummary.isStockholder && stockholderSummary.enabled}}" class="card stockholder-benefits-card">
      <view class="card-title stockholder-benefits-title">
        <mbs-icon name="award" size="36" color="#b45309" />
        股东会员专享权益
      </view>
      <view class="stockholder-benefits-tags">
        <view wx:for="{{stockholderSummary.benefits}}" wx:key="*this" class="stockholder-benefit-tag">{{item}}</view>
      </view>
    </view>

    <!-- 邀请好友 -->
    <view wx:if="{{customer && isMember}}" class="card invite-card" bindtap="goToInvite">
      <view class="invite-left">
        <view class="share-pulse">
          <mbs-icon name="share-2" size="40" color="#ffffff" />
        </view>
        <view class="invite-text">
          <view class="invite-title">邀请新顾客 · 一起变美</view>
          <view class="invite-hint">好友消费后，你可获得 {{(customer.referralBonusRate || 0.10) * 100}}% 奖励金，可用于店内消费</view>
        </view>
      </view>
      <view class="invite-action-label">立即邀请 ›</view>
    </view>

    <!-- 6) 我的可用权益 -->
    <view wx:if="{{myBenefits.length > 0}}" class="card">
      <view class="card-title" >
        <mbs-icon name="gift" size="32" color="var(--primary)" />
        我的可用权益
      </view>
      <view class="benefit-list">
        <view wx:for="{{myBenefits}}" wx:key="index" class="benefit-item">
          <view class="benefit-left">
            <mbs-icon name="{{fmt.benefitIconName(item.type)}}" size="28" color="{{fmt.benefitIconColor(item.type)}}" />
            <text class="benefit-name">{{item.name}}</text>
          </view>
          <text class="benefit-desc">{{item.description}}</text>
        </view>
      </view>
    </view>

    <!-- 9) 我的预约 -->
    <view class="card">
      <view class="booking-header">
        <view class="card-title booking-title" >
          <mbs-icon name="calendar" size="32" color="var(--primary)" />
          我的预约
        </view>
        <view class="tab-switcher">
          <view class="tab-item {{activeTab === 'current' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="current">当前</view>
          <view class="tab-item {{activeTab === 'history' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="history">历史</view>
        </view>
      </view>

      <view wx:if="{{loading}}" class="empty-text" style="padding: 48rpx 0;">加载中...</view>

      <block wx:else>
        <view wx:if="{{!hasFilteredBookings}}" class="empty-state" style="padding: 48rpx 0;">
          <view class="empty-icon">
            <mbs-icon name="calendar" size="56" color="var(--text-tertiary)" />
          </view>
          <view class="empty-text">{{activeTab === 'current' ? '暂无进行中的预约' : '暂无历史预约'}}</view>
          <view wx:if="{{activeTab === 'current'}}" class="btn btn-primary btn-small" style="margin-top: 24rpx;" bindtap="goToBooking">
            去预约
            <mbs-icon name="chevronRight" size="20" color="#fff" />
          </view>
        </view>

        <view wx:else class="booking-list">
          <view
            wx:for="{{filteredBookings}}"
            wx:key="id"
            wx:for-item="booking"
            class="booking-item"
            bindtap="onBookingTap"
            data-id="{{booking.id}}"
          >
            <view class="booking-main">
              <view class="booking-info">
                <view class="booking-stylist">设计师：{{booking.barberName || '待安排'}}</view>
                <view class="booking-service">{{booking.serviceName}}</view>
              </view>
              <mbs-status-badge status="{{booking.status}}" />
            </view>
            <view class="booking-meta">
              <view class="booking-time">
                <mbs-icon name="clock" size="20" color="var(--text-tertiary)" />
                {{fmt.formatDateTime(booking.scheduledTime)}}
              </view>
              <mbs-price current="{{booking.price}}" size="sm" show-tag="{{false}}" />
            </view>

            <view wx:if="{{booking.status === 'confirmed'}}" class="profile-queue-direct" catchtap="goToQueue" data-id="{{booking.id}}">查看排队 / 暂离 / 返回 ›</view>

            <!-- 延时警示 -->
            <view wx:if="{{booking.delayState === 'needs_action'}}" class="booking-delay-banner">
              <view class="booking-delay-banner-text">
                <mbs-icon name="alertCircle" size="24" color="#b45309" />
                <text>发型师临时延时，请选择处理方式</text>
              </view>
              <view wx:if="{{booking.delayReason}}" class="booking-delay-banner-reason">{{booking.delayReason}}</view>
              <view class="booking-delay-actions">
                <view class="booking-delay-btn booking-delay-btn-primary" catchtap="openReschedule" data-id="{{booking.id}}">改时间</view>
                <view class="booking-delay-btn" catchtap="callStore">联系门店</view>
              </view>
            </view>
            <view wx:if="{{booking.delayState === 'no_response'}}" class="booking-delay-banner booking-delay-banner-error">
              <mbs-icon name="alertCircle" size="24" color="#dc2626" />
              <text>该预约延时已超时未处理，请联系门店</text>
            </view>

            <!-- 三端协同：历史/已完成订单增加评价入口（对齐H5 Profile） -->
            <view wx:if="{{activeTab === 'history' && booking.status === 'completed'}}" class="booking-actions">
              <block wx:if="{{bookingReviewedMap[booking.id]}}">
                <view
                  class="booking-link booking-link-green"
                  catchtap="onBookingTap"
                  data-id="{{booking.id}}"
                >
                  <mbs-icon name="checkCircle" size="22" color="#16a34a" />
                  <text>已评价，查看评价</text>
                </view>
              </block>
              <block wx:else>
                <view
                  class="booking-link booking-link-blue"
                  catchtap="onBookingTap"
                  data-id="{{booking.id}}"
                >
                  <mbs-icon name="star" size="22" color="#2563eb" />
                  <text>去评价</text>
                </view>
              </block>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="card product-orders-entry" bindtap="goToProductOrders" role="button" aria-label="我的商品订单">
      <mbs-icon name="shoppingBag" size="40" color="var(--primary)" />
      <view class="product-orders-entry-text">
        <view class="product-orders-entry-title">我的商品订单</view>
        <view class="product-orders-entry-hint">查看订单、提货与退款</view>
      </view>
      <mbs-icon name="chevronRight" size="32" color="var(--text-tertiary)" />
    </view>

    <!-- 10) 快捷功能 3 列网格 -->
    <view class="quick-grid">
      <view class="quick-item" bindtap="goToPackages">
        <mbs-icon name="gift" size="40" color="var(--accent)" />
        <view class="quick-title">我的次卡</view>
        <view class="quick-hint">查看剩余次数</view>
      </view>
      <view class="quick-item" bindtap="goToCoupons">
        <mbs-icon name="ticket" size="40" color="var(--accent)" />
        <view class="quick-title">我的优惠券</view>
        <view class="quick-hint">查看已领券</view>
      </view>
      <view class="quick-item" bindtap="goToRefund">
        <mbs-icon name="alertCircle" size="40" color="var(--accent)" />
        <view class="quick-title">退款管理</view>
        <view class="quick-hint">申请退款查看进度</view>
      </view>
      <view class="quick-item" bindtap="goToFeedback">
        <mbs-icon name="messageSquare" size="40" color="var(--primary)" />
        <view class="quick-title">意见反馈</view>
        <view class="quick-hint">提交建议和投诉</view>
      </view>
    </view>

    <!-- 11) 协议与政策 -->
    <view class="profile-legal-section">
      <view class="legal-item" bindtap="goToAgreement">
        <view class="legal-item-left">
          <mbs-icon name="fileText" size="28" color="var(--text-secondary)" />
          <text class="legal-item-text">用户协议</text>
        </view>
        <mbs-icon name="arrowLeft" size="28" color="var(--text-tertiary)" class="legal-item-arrow" />
      </view>
      <view class="legal-item" bindtap="goToPrivacy">
        <view class="legal-item-left">
          <mbs-icon name="shield" size="28" color="var(--text-secondary)" />
          <text class="legal-item-text">隐私政策</text>
        </view>
        <mbs-icon name="arrowLeft" size="28" color="var(--text-tertiary)" class="legal-item-arrow" />
      </view>
    </view>

    <!-- 12) 退出登录 -->
    <view class="btn btn-logout" bindtap="handleLogout">
      <mbs-icon name="logOut" size="28" color="var(--danger)" />
      退出登录
    </view>
  </view>

  <!-- 13) 预约详情弹窗 -->
  <view wx:if="{{viewingBooking}}" class="modal-mask" catchtap="closeBookingModal">
    <view class="modal-dialog" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-title">预约详情</view>
        <view class="modal-close" catchtap="closeBookingModal">
          <mbs-icon name="close" size="32" color="var(--text-tertiary)" />
        </view>
      </view>

      <view class="modal-body">
        <view class="modal-status">
          <mbs-status-badge status="{{viewingBooking.status}}" />
        </view>

        <!-- 延时警示（详情） -->
        <view wx:if="{{viewingBooking.delayState === 'needs_action'}}" class="modal-delay-banner">
          <view class="modal-delay-banner-text">发型师临时延时，请选择处理方式</view>
          <view wx:if="{{viewingBooking.delayReason}}" class="modal-delay-banner-reason">{{viewingBooking.delayReason}}</view>
          <view class="modal-delay-actions">
            <view class="booking-delay-btn booking-delay-btn-primary" bindtap="openReschedule" data-id="{{viewingBooking.id}}">改时间</view>
            <view class="booking-delay-btn" bindtap="callStore">联系门店</view>
          </view>
        </view>
        <view wx:if="{{viewingBooking.delayState === 'no_response'}}" class="modal-delay-banner modal-delay-banner-error">
          <mbs-icon name="alertCircle" size="24" color="#dc2626" />
          <text>该预约延时已超时未处理，请联系门店</text>
        </view>

        <view class="info-list">
          <view class="info-row">
            <text class="info-label"><mbs-icon name="mapPin" size="24" color="var(--text-tertiary)" /> 店铺</text>
            <text class="info-value">{{viewingBooking.shopName || 'MBS 理发店'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label"><mbs-icon name="scissors" size="24" color="var(--text-tertiary)" /> 服务项目</text>
            <text class="info-value">{{viewingBooking.serviceName}}</text>
          </view>
          <view class="info-row">
            <text class="info-label"><mbs-icon name="calendar" size="24" color="var(--text-tertiary)" /> 预约时间</text>
            <text class="info-value">{{fmt.formatDateTime(viewingBooking.scheduledTime)}}</text>
          </view>
          <view class="info-row">
            <text class="info-label"><mbs-icon name="user" size="24" color="var(--text-tertiary)" /> 发型师</text>
            <text class="info-value">{{viewingBooking.barberName || '待安排'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">¥ 服务价格</text>
            <text class="info-value"><mbs-price current="{{viewingBooking.price}}" size="sm" show-tag="{{false}}" /></text>
          </view>
          <view class="info-row">
            <text class="info-label"># 排队号</text>
            <text class="info-value">#{{viewingBooking.queueNumber || '-'}}</text>
          </view>
          <view wx:if="{{viewingBooking.notes}}" class="info-row info-row-start">
            <text class="info-label"><mbs-icon name="messageSquare" size="24" color="var(--text-tertiary)" /> 备注</text>
            <text class="info-value">{{viewingBooking.notes}}</text>
          </view>
        </view>
      </view>

      <view class="modal-footer">
        <view wx:if="{{viewingBooking.status === 'confirmed'}}" class="btn btn-primary" bindtap="goToQueue">查看排队状态</view>
        <view wx:if="{{viewingBooking.status === 'pending'}}" class="btn btn-secondary">店铺确认后生成排队信息</view>

        <!-- 已完成预约：评价入口（三端协同对齐H5） -->
        <block wx:if="{{viewingBooking.status === 'completed'}}">
          <view wx:if="{{bookingReviewedMap[viewingBooking.id]}}" class="btn btn-success" bindtap="goToReview">
            <mbs-icon name="checkCircle" size="22" color="#ffffff" />
            <text>已评价，查看</text>
          </view>
          <view wx:else class="btn btn-primary" bindtap="goToReview">
            <mbs-icon name="star" size="22" color="#ffffff" />
            <text>去评价</text>
          </view>
        </block>

        <view wx:if="{{viewingBooking.status === 'pending' || viewingBooking.status === 'confirmed'}}" class="btn btn-danger {{cancelling ? 'btn-disabled' : ''}}" bindtap="handleCancelBooking">
          {{cancelling ? '取消中...' : '取消预约'}}
        </view>
        <view class="btn btn-secondary" bindtap="closeBookingModal">关闭</view>
      </view>
    </view>
  </view>

  <!-- 14) 延时改时间弹窗 -->
  <view wx:if="{{rescheduleTarget}}" class="modal-mask" catchtap="closeRescheduleModal">
    <view class="modal-dialog" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-title">更改预约时间</view>
        <view class="modal-close" catchtap="closeRescheduleModal">
          <mbs-icon name="close" size="32" color="var(--text-tertiary)" />
        </view>
      </view>
      <view class="modal-body">
        <view class="reschedule-hint">请选择新的预约时间（避开发型师已有预约）</view>
        <view class="reschedule-pickers">
          <picker mode="date" value="{{rescheduleDate}}" bindchange="onRescheduleDateChange">
            <view class="reschedule-picker">{{rescheduleDate || '选择日期'}}</view>
          </picker>
          <picker mode="time" value="{{rescheduleTime}}" bindchange="onRescheduleTimeChange">
            <view class="reschedule-picker">{{rescheduleTime || '选择时间'}}</view>
          </picker>
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn btn-primary {{rescheduling ? 'btn-disabled' : ''}}" bindtap="submitReschedule">{{rescheduling ? '提交中...' : '确认改时间'}}</view>
        <view class="btn btn-secondary" bindtap="closeRescheduleModal">取消</view>
      </view>
    </view>
