/* 个人中心 —— 与 H5 Profile.tsx 视觉严格统一 */

.profile-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 24rpx 0 calc(148rpx + env(safe-area-inset-bottom, 0px));
}

.profile-page .card {
  margin: 0 0 24rpx;
  padding: 28rpx;
  background: #fffdf9;
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(113, 69, 35, 0.04);
}

.profile-page .card-title {
  color: var(--text-primary);
  font-size: 30rpx;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.profile-page .container {
  padding: 0 24rpx;
}

/* ===== 渐变头部（按等级配色） ===== */
.vip-header {
  position: relative;
  overflow: hidden;
  color: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
}

.gradient-vip-regular {
  background: linear-gradient(135deg, #9ca3af, #6b7280);
}

.gradient-vip-bronze {
  background: linear-gradient(135deg, #fb923c, #f97316);
}

.gradient-vip-silver {
  background: linear-gradient(135deg, #60a5fa, #2563eb);
}

.gradient-vip-gold {
  background: linear-gradient(135deg, #facc15, #ca8a04);
}

.gradient-vip-diamond {
  background: linear-gradient(135deg, #a855f7, #ec4899, #f97316);
}

/* 装饰背景圆 */
.vip-decor {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.vip-decor-1 {
  width: 320rpx;
  height: 320rpx;
  right: -80rpx;
  top: -80rpx;
}

.vip-decor-2 {
  width: 256rpx;
  height: 256rpx;
  right: -128rpx;
  top: 80rpx;
  background: rgba(255, 255, 255, 0.05);
}

.vip-decor-3 {
  width: 160rpx;
  height: 160rpx;
  left: 32rpx;
  bottom: 32rpx;
  background: rgba(255, 255, 255, 0.1);
  filter: blur(16rpx);
}

.vip-header-inner {
  position: relative;
  z-index: 1;
}

/* 基本信息行 */
.vip-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
  flex-wrap: wrap;
  gap: 20rpx;
}

.vip-info-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.vip-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.vip-avatar-image { width: 100%; height: 100%; border-radius: 50%; }
.profile-self-actions { display: flex; gap: 14rpx; margin: -4rpx 0 24rpx; }
.profile-self-action { flex: 1; text-align: center; padding: 16rpx 8rpx; border-radius: 16rpx; background: rgba(255,255,255,.18); border: 1rpx solid rgba(255,255,255,.38); color: #fff; font-size: 25rpx; font-weight: 650; }
.profile-self-action-primary { background: #fff0dd; color: #82482c; border-color: #fff4e8; }
.profile-edit-dialog { max-width: 640rpx; width: calc(100% - 64rpx); }
.profile-edit-body { padding: 24rpx; }
.profile-edit-avatar { width: 112rpx; height: 112rpx; margin: 0 auto; border-radius: 50%; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #f8e9dc; }
.profile-edit-avatar image { width: 100%; height: 100%; }
.profile-edit-avatar-hint { text-align: center; color: #8b6958; font-size: 24rpx; margin: 10rpx 0 22rpx; }
.profile-edit-field { margin-bottom: 20rpx; font-size: 25rpx; color: #47372e; }
.profile-edit-field text { display: block; margin-bottom: 8rpx; font-weight: 600; }
.profile-edit-field input, .profile-edit-choice { box-sizing: border-box; width: 100%; min-height: 78rpx; padding: 16rpx 20rpx; border: 1rpx solid #e9d8c8; border-radius: 14rpx; background: #fffcf8; color: #382c27; }
.profile-edit-note { font-size: 22rpx; color: #806d61; line-height: 1.5; margin-bottom: 22rpx; }
.profile-edit-save { background: #efa66e; color: #2b2018; font-size: 28rpx; font-weight: 700; border-radius: 16rpx; }

.vip-identity {
  display: flex;
  flex-direction: column;
}

.vip-name {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.vip-phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.vip-info-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.vip-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  font-size: 28rpx;
  font-weight: 700;
}

.vip-badge-sub {
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 24rpx;
}

/* 折扣卡 */
.vip-discount-card {
  background: rgba(255,255,255,0.14);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.vip-discount-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.vip-discount-value {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 8rpx;
}

.vip-discount-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.4;
}

/* 4 列数据速览 */
.vip-stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.vip-stat-item {
  background: rgba(255,255,255,0.12);
  border: 1rpx solid rgba(255,255,255,0.14);
  border-radius: 18rpx;
  padding: 20rpx;
  min-width: 0;
}

.vip-stat-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.vip-stat-value {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  overflow-wrap: break-word;
}

.vip-stat-action {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

/* 到期提醒 */
.vip-alert {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
}

.vip-alert-yellow {
  background: rgba(250, 204, 21, 0.2);
  border: 1rpx solid rgba(254, 240, 138, 0.3);
}

.vip-alert-orange {
  background: rgba(251, 146, 60, 0.2);
  border: 1rpx solid rgba(254, 215, 170, 0.3);
}

/* 股东专属 */
.vip-stockholder {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8rpx);
  border-radius: 24rpx;
  padding: 24rpx;
}

.vip-stockholder-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.vip-stockholder-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vip-stockholder-value {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.vip-stockholder-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.vip-stockholder-crown {
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.35;
}

/* 主内容区 */
.profile-content {
  margin-top: 0;
  position: relative;
}

/* 未登录占位 */
.login-placeholder-card {
  margin-top: 24rpx;
}

.login-placeholder {
  text-align: center;
  padding: 48rpx 0 32rpx;
}

.login-placeholder-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--gray-100);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.placeholder-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.placeholder-hint {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

/* 股东权益说明卡 */
.stockholder-benefits-card {
  background: linear-gradient(to right, var(--amber-50), #fff7ed);
  border: 1rpx solid var(--amber-100);
}

.stockholder-benefits-title {
  color: #b45309;
}

.stockholder-benefits-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.stockholder-benefit-tag {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.7);
  color: var(--amber-700);
  border-radius: 9999rpx;
  border: 1rpx solid var(--amber-200);
  font-weight: 500;
}

/* 邀请好友 —— 醒目暖色卡片 */
.profile-page .invite-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
  position: relative;
  overflow: hidden;
  background: linear-gradient(120deg, #ffc18c, #ffad6b);
  border: none;
  box-shadow: 0 12rpx 40rpx rgba(153, 97, 63, 0.16);
  color: var(--on-action);
  padding: 40rpx 36rpx;
}

.profile-page .invite-card::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.profile-page .invite-card::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -40rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.profile-page .invite-left {
  flex: 1 1 360rpx;
  min-width: 0;
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.profile-page .invite-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-page .invite-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--on-action);
}

.profile-page .invite-hint {
  font-size: 26rpx;
  color: #513c2d;
  font-weight: 500;
}

.profile-page .invite-card .mbs-icon,
.profile-page .invite-card mbs-icon {
  color: #fff !important;
}

.profile-page .invite-card .share-pulse {
  position: relative;
  z-index: 1;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #99613f;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;

}

@keyframes pulse-soft {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.08); opacity: 0.85; }
}

/* 可用权益 */
.benefit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: var(--gray-50);
  border-radius: 24rpx;
}

.benefit-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.benefit-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.benefit-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 权益对比表格 */
.benefits-table-wrap {
  overflow-x: auto;
  margin: 0 -8rpx;
}

.benefits-table {
  display: table;
  width: 100%;
  min-width: 640rpx;
  font-size: 24rpx;
}

.benefits-row {
  display: table-row;
  border-bottom: 1rpx solid var(--border);
}

.benefits-row:last-child {
  border-bottom: none;
}

.benefits-header {
  font-weight: 500;
  color: var(--text-secondary);
  border-bottom: 1rpx solid var(--gray-200);
}

.benefits-cell {
  display: table-cell;
  padding: 20rpx 12rpx;
  text-align: center;
  vertical-align: middle;
}

.benefits-feature {
  text-align: left;
  color: var(--text-primary);
  font-weight: 500;
  padding-left: 12rpx;
}

/* 表格高亮背景 */
.bg-orange-light { background: rgba(217, 122, 69, 0.06); }
.bg-blue-light { background: rgba(59, 130, 246, 0.06); }
.bg-yellow-light { background: rgba(202, 138, 4, 0.08); }
.bg-purple-light { background: rgba(168, 85, 247, 0.06); }
.bg-green-light { background: rgba(34, 197, 94, 0.08); }
.bg-cyan-light { background: rgba(6, 182, 212, 0.06); }
.bg-indigo-light { background: rgba(99, 102, 241, 0.06); }
.bg-red-light { background: rgba(239, 68, 68, 0.06); }

.text-orange-600 { color: #ea580c; }
.text-blue-600 { color: #2563eb; }
.text-yellow-600 { color: #ca8a04; }
.text-purple-600 { color: #9333ea; }
.text-green-600 { color: #16a34a; }
.text-cyan-600 { color: #0891b2; }
.text-indigo-600 { color: #4f46e5; }
.text-red-600 { color: #dc2626; }
.text-gray-500 { color: var(--text-tertiary); }

.font-bold { font-weight: 700; }

/* 当前会员卡片 */
.vip-current-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
  padding: 24rpx;
}

.vip-current-info {
  flex: 1;
  min-width: 0;
}

.vip-current-orange {
  background: linear-gradient(90deg, var(--amber-50), var(--yellow-50));
  border: 1rpx solid var(--amber-200);
}

.vip-current-green {
  background: linear-gradient(90deg, var(--green-50), #ecfdf5);
  border: 1rpx solid var(--green-200);
}

.vip-current-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.vip-current-orange .vip-current-title { color: var(--amber-700); }
.vip-current-green .vip-current-title { color: var(--green-700); }

.vip-current-desc {
  font-size: 24rpx;
  line-height: 1.4;
}

.vip-current-orange .vip-current-desc { color: var(--amber-600); }
.vip-current-green .vip-current-desc { color: var(--green-600); }

/* 预约头部 */
.booking-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.booking-title {
  margin-bottom: 0;
}

/* Tab 切换 */
.tab-switcher {
  display: inline-flex;
  background: #f5ede3;
  border-radius: 14rpx;
  padding: 5rpx;
}

.tab-item {
  padding: 12rpx 24rpx;
  font-size: 25rpx;
  font-weight: 500;
  border-radius: 10rpx;
  color: var(--text-secondary);
}

.tab-active {
  background: linear-gradient(135deg, var(--action-start), var(--action-end));
  color: var(--on-action);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(113,69,35,0.08);
}

/* 预约列表 */
.booking-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.booking-item {
  border: 1rpx solid var(--border);
  background: #fffbf6;
  border-radius: 18rpx;
  padding: 24rpx;
}

.booking-item:active {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.booking-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.booking-info {
  flex: 1;
  min-width: 0;
}

.booking-stylist {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.booking-service {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.booking-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.booking-time {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 延时警示 */
.booking-delay-banner {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 16rpx;
}
.booking-delay-banner-error {
  background: #fef2f2;
  border-color: #fecaca;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #dc2626;
}
.booking-delay-banner-text {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #92400e;
}
.booking-delay-banner-reason {
  font-size: 22rpx;
  color: #b45309;
  margin-top: 4rpx;
}
.booking-delay-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.booking-delay-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #92400e;
  background: #fff;
  border: 1rpx solid #fcd34d;
}
.booking-delay-btn-primary {
  background: #f59e0b;
  color: #fff;
  border-color: #f59e0b;
}

/* 延时详情弹窗 */
.modal-delay-banner {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 16rpx;
}
.modal-delay-banner-error {
  background: #fef2f2;
  border-color: #fecaca;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #dc2626;
}
.modal-delay-banner-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #92400e;
  margin-bottom: 4rpx;
}
.modal-delay-banner-reason {
  font-size: 22rpx;
  color: #b45309;
  margin-bottom: 12rpx;
}
.modal-delay-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

/* 改时间弹窗 */
.reschedule-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}
.reschedule-pickers {
  display: flex;
  gap: 16rpx;
}
.reschedule-picker {
  flex: 1;
  padding: 20rpx;
  border: 1rpx solid var(--gray-200);
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-primary);
}

/* 快捷功能 */
.quick-grid {
  display: grid;
  grid-template-columns: minmax(0,1fr) minmax(0,1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.quick-item {
  background: #fffdf9;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  border: 1rpx solid var(--border);
  min-width: 0;
  min-height: 156rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 12rpx;
}

.quick-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.quick-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* 协议与政策 */
.profile-legal-section {
  background: #fffdf9;
  border: 1rpx solid var(--border);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.legal-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--gray-100);
}

.legal-item:last-child {
  border-bottom: none;
}

.legal-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.legal-item-text {
  font-size: 30rpx;
  color: var(--text-primary);
}

.legal-item-arrow {
  transform: rotate(180deg);
}

/* 退出登录 */
.btn-logout {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 26rpx 0;
  border-radius: 20rpx;
  background: #fffdf9;
  color: var(--text-secondary);
  border: 1rpx solid var(--border);
  font-size: 28rpx;
  font-weight: 500;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 48rpx 32rpx;
}

.modal-dialog {
  background: #fff;
  border-radius: 32rpx;
  width: 100%;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--gray-100);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  padding: 8rpx;
  border-radius: 12rpx;
}

.modal-body {
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.modal-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: var(--gray-50);
}

.modal-footer {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom, 0));
  border-top: 1rpx solid var(--gray-100);
}

/* 信息列表 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-top: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--gray-100);
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row-start {
  align-items: flex-start;
}

.info-row-start .info-value {
  text-align: left;
  flex: 1;
}

.info-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.info-value {
  font-weight: 500;
  color: var(--text-primary);
  font-size: 28rpx;
}

/* 工具类 */
.min-w-0 { min-width: 0; }
.text-center { text-align: center; }

.product-orders-entry {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.product-orders-entry-text { flex: 1; min-width: 0; }
.product-orders-entry-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.product-orders-entry-hint { margin-top: 8rpx; font-size: 24rpx; color: var(--text-secondary); }

/* 未使用但保留给 JS 动态类 */
.bg-gray-light { background: var(--gray-100); }

/* 会员权益对比保持原等级色，突出栏目层级。 */
.membership-system-card { border: 2rpx solid #edcfb5; box-shadow: 0 8rpx 24rpx rgba(113, 69, 35, 0.06); }
.membership-system-card .card-title { font-size: 34rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #f1dfca; }

/* 个人中心标题、会员与邀请层级统一；会员等级渐变沿用原配色。 */
.profile-page .booking-title { margin-bottom: 0; }
.profile-page .invite-card { padding: 28rpx; border: 1rpx solid #edc5a1; border-radius: 24rpx; box-shadow: 0 6rpx 20rpx rgba(113,69,35,0.06); }
.profile-page .invite-title { font-size: 30rpx; line-height: 1.5; }
.profile-page .invite-hint { font-size: 24rpx; line-height: 1.7; font-weight: 400; }
.profile-page .invite-text { min-width: 0; }
.profile-page .invite-action-label { position: relative; padding: 14rpx 24rpx; border-radius: 14rpx; background: rgba(255,255,255,0.7); color: var(--on-action); font-size: 25rpx; font-weight: 700; }
.profile-page .benefit-item { background: #fff6eb; border: 1rpx solid var(--border); border-radius: 16rpx; }
.profile-page .benefit-desc { line-height: 1.6; }
.profile-page .stockholder-benefits-card { background: #fff5e8; }
.profile-page .stockholder-benefit-tag { color: var(--primary-dark); border-color: var(--primary-border); }

.profile-queue-direct { padding:20rpx; margin-top:18rpx; border-radius:14rpx; background:linear-gradient(135deg,var(--action-start),var(--action-end)); color:var(--on-action); font-size:26rpx; font-weight:700; text-align:center; }
