/* 个人中心 —— 与 H5 Profile.tsx 视觉严格统一 */

.profile-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom, 0));
}

.profile-page .container {
  padding: 32rpx;
}

/* ===== 渐变头部（按等级配色） ===== */
.vip-header {
  position: relative;
  overflow: hidden;
  color: #fff;
  padding: 48rpx 24rpx calc(64rpx + env(safe-area-inset-top, 0));
}

.gradient-vip-regular {
  background: linear-gradient(135deg, #9ca3af, #6b7280);
}

.gradient-vip-bronze {
  background: linear-gradient(135deg, #fb923c, #f97316);
}

.gradient-vip-silver {
  background: linear-gradient(135deg, #60a5fa, #2563eb);
}

.gradient-vip-gold {
  background: linear-gradient(135deg, #facc15, #ca8a04);
}

.gradient-vip-diamond {
  background: linear-gradient(135deg, #a855f7, #ec4899, #f97316);
}

/* 装饰背景圆 */
.vip-decor {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.vip-decor-1 {
  width: 320rpx;
  height: 320rpx;
  right: -80rpx;
  top: -80rpx;
}

.vip-decor-2 {
  width: 256rpx;
  height: 256rpx;
  right: -128rpx;
  top: 80rpx;
  background: rgba(255, 255, 255, 0.05);
}

.vip-decor-3 {
  width: 160rpx;
  height: 160rpx;
  left: 32rpx;
  bottom: 32rpx;
  background: rgba(255, 255, 255, 0.1);
  filter: blur(16rpx);
}

.vip-header-inner {
  position: relative;
  z-index: 1;
}

/* 基本信息行 */
.vip-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.vip-info-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.vip-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.vip-identity {
  display: flex;
  flex-direction: column;
}

.vip-name {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.vip-phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.vip-info-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.vip-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  font-size: 26rpx;
  font-weight: 500;
}

.vip-badge-sub {
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 24rpx;
}

/* 折扣卡 */
.vip-discount-card {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8rpx);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.vip-discount-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.vip-discount-value {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 8rpx;
}

.vip-discount-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.4;
}

/* 4 列数据速览 */
.vip-stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.vip-stat-item {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8rpx);
  border-radius: 24rpx;
  padding: 24rpx;
}

.vip-stat-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 8rpx;
}

.vip-stat-value {
  font-size: 34rpx;
  font-weight: 700;
}

.vip-stat-action {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

/* 到期提醒 */
.vip-alert {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
  padding: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
}

.vip-alert-yellow {
  background: rgba(250, 204, 21, 0.2);
  border: 1rpx solid rgba(254, 240, 138, 0.3);
}

.vip-alert-orange {
  background: rgba(251, 146, 60, 0.2);
  border: 1rpx solid rgba(254, 215, 170, 0.3);
}

/* 股东专属 */
.vip-stockholder {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8rpx);
  border-radius: 24rpx;
  padding: 24rpx;
}

.vip-stockholder-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.vip-stockholder-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vip-stockholder-value {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.vip-stockholder-hint {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.vip-stockholder-crown {
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.35;
}

/* 主内容区 */
.profile-content {
  margin-top: -24rpx;
  position: relative;
  z-index: 2;
}

/* 未登录占位 */
.login-placeholder-card {
  margin-top: 24rpx;
}

.login-placeholder {
  text-align: center;
  padding: 48rpx 0 32rpx;
}

.login-placeholder-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--gray-100);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.placeholder-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.placeholder-hint {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

/* 股东权益说明卡 */
.stockholder-benefits-card {
  background: linear-gradient(to right, var(--amber-50), #fff7ed);
  border: 1rpx solid var(--amber-100);
}

.stockholder-benefits-title {
  color: #b45309;
}

.stockholder-benefits-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.stockholder-benefit-tag {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.7);
  color: var(--amber-700);
  border-radius: 9999rpx;
  border: 1rpx solid var(--amber-200);
  font-weight: 500;
}

/* 可用权益 */
.benefit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.benefit-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: var(--gray-50);
  border-radius: 24rpx;
}

.benefit-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.benefit-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.benefit-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 权益对比表格 */
.benefits-table-wrap {
  overflow-x: auto;
  margin: 0 -8rpx;
}

.benefits-table {
  display: table;
  width: 100%;
  min-width: 640rpx;
  font-size: 24rpx;
}

.benefits-row {
  display: table-row;
  border-bottom: 1rpx solid var(--border);
}

.benefits-row:last-child {
  border-bottom: none;
}

.benefits-header {
  font-weight: 500;
  color: var(--text-secondary);
  border-bottom: 1rpx solid var(--gray-200);
}

.benefits-cell {
  display: table-cell;
  padding: 20rpx 12rpx;
  text-align: center;
  vertical-align: middle;
}

.benefits-feature {
  text-align: left;
  color: var(--text-primary);
  font-weight: 500;
  padding-left: 12rpx;
}

/* 表格高亮背景 */
.bg-orange-light { background: rgba(217, 122, 69, 0.06); }
.bg-blue-light { background: rgba(59, 130, 246, 0.06); }
.bg-yellow-light { background: rgba(202, 138, 4, 0.08); }
.bg-purple-light { background: rgba(168, 85, 247, 0.06); }
.bg-green-light { background: rgba(34, 197, 94, 0.08); }
.bg-cyan-light { background: rgba(6, 182, 212, 0.06); }
.bg-indigo-light { background: rgba(99, 102, 241, 0.06); }
.bg-red-light { background: rgba(239, 68, 68, 0.06); }

.text-orange-600 { color: #ea580c; }
.text-blue-600 { color: #2563eb; }
.text-yellow-600 { color: #ca8a04; }
.text-purple-600 { color: #9333ea; }
.text-green-600 { color: #16a34a; }
.text-cyan-600 { color: #0891b2; }
.text-indigo-600 { color: #4f46e5; }
.text-red-600 { color: #dc2626; }
.text-gray-500 { color: var(--text-tertiary); }

.font-bold { font-weight: 700; }

/* 当前会员卡片 */
.vip-current-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  border-radius: 24rpx;
  padding: 24rpx;
}

.vip-current-info {
  flex: 1;
  min-width: 0;
}

.vip-current-orange {
  background: linear-gradient(90deg, var(--amber-50), var(--yellow-50));
  border: 1rpx solid var(--amber-200);
}

.vip-current-green {
  background: linear-gradient(90deg, var(--green-50), #ecfdf5);
  border: 1rpx solid var(--green-200);
}

.vip-current-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.vip-current-orange .vip-current-title { color: var(--amber-700); }
.vip-current-green .vip-current-title { color: var(--green-700); }

.vip-current-desc {
  font-size: 24rpx;
  line-height: 1.4;
}

.vip-current-orange .vip-current-desc { color: var(--amber-600); }
.vip-current-green .vip-current-desc { color: var(--green-600); }

/* 预约头部 */
.booking-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.booking-title {
  margin-bottom: 0;
}

/* Tab 切换 */
.tab-switcher {
  display: inline-flex;
  background: var(--gray-100);
  border-radius: 16rpx;
  padding: 6rpx;
}

.tab-item {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 12rpx;
  color: var(--text-secondary);
  transition: all 0.15s;
}

.tab-active {
  background: #fff;
  color: var(--text-primary);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 预约列表 */
.booking-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.booking-item {
  border: 1rpx solid var(--gray-200);
  border-radius: 24rpx;
  padding: 24rpx;
  transition: box-shadow 0.15s;
}

.booking-item:active {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.booking-main {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.booking-info {
  flex: 1;
  min-width: 0;
}

.booking-shop {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.booking-service {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.booking-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.booking-time {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 快捷功能 */
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.quick-item {
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx;
  border: 1rpx solid var(--gray-100);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  min-height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.quick-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.quick-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* 退出登录 */
.btn-logout {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  padding: 28rpx 0;
  border-radius: 24rpx;
  background: #fff;
  color: var(--danger);
  border: 2rpx solid var(--red-300);
  font-size: 30rpx;
  font-weight: 600;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 48rpx 32rpx;
}

.modal-dialog {
  background: #fff;
  border-radius: 32rpx;
  width: 100%;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--gray-100);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.modal-close {
  padding: 8rpx;
  border-radius: 12rpx;
}

.modal-body {
  padding: 24rpx 32rpx;
  overflow-y: auto;
}

.modal-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  background: var(--gray-50);
}

.modal-footer {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom, 0));
  border-top: 1rpx solid var(--gray-100);
}

/* 信息列表 */
.info-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-top: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--gray-100);
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row-start {
  align-items: flex-start;
}

.info-row-start .info-value {
  text-align: left;
  flex: 1;
}

.info-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}

.info-value {
  font-weight: 500;
  color: var(--text-primary);
  font-size: 28rpx;
}

/* 提现弹窗 */
.withdraw-balance-card {
  background: rgba(217, 122, 69, 0.08);
  border: 1rpx solid rgba(217, 122, 69, 0.2);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.withdraw-balance-label {
  font-size: 24rpx;
  color: var(--amber-700);
  margin-bottom: 8rpx;
}

.withdraw-balance-value {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--amber-600);
}

.withdraw-section {
  margin-bottom: 24rpx;
}

.withdraw-section-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.withdraw-channel-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.withdraw-channel-item {
  padding: 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--gray-200);
  text-align: center;
  transition: all 0.2s;
}

.withdraw-channel-active {
  border-color: var(--accent);
  background: rgba(245, 158, 11, 0.06);
}

.withdraw-channel-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.withdraw-channel-hint {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
  line-height: 1.4;
}

.withdraw-amount-wrap {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--gray-200);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--gray-50);
}

.withdraw-amount-symbol {
  font-size: 32rpx;
  color: var(--text-tertiary);
  margin-right: 12rpx;
}

.withdraw-amount-input {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  background: transparent;
}

.withdraw-amount-all {
  font-size: 24rpx;
  color: var(--accent);
  text-align: right;
  margin-top: 12rpx;
}

/* 工具类 */
.min-w-0 { min-width: 0; }
.text-center { text-align: center; }

/* 未使用但保留给 JS 动态类 */
.bg-gray-light { background: var(--gray-100); }