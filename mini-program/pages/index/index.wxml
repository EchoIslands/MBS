<wxs src="../../utils/format.wxs" module="fmt" />
<view class="index-page {{tabTransitionClass}}" bindtouchstart="onTabSwipeStart" bindtouchend="onTabSwipeEnd" bindtouchcancel="onTabSwipeCancel">
  <!-- 主入口由底部导航承载，顶部只保留店铺名称 -->
  <view class="index-nav-bar">
    <view class="index-nav-title">{{shop.name || '皓诗形象设计'}}</view>
  </view>
  <view wx:if="{{activeQueueBooking}}" class="active-queue-entry" bindtap="goToActiveQueue" role="button" aria-label="查看今日预约与排队">
    <view><text class="active-queue-title">今日预约 · 查看排队</text><text class="active-queue-service">{{activeQueueBooking.serviceName}}</text></view>
    <text class="active-queue-arrow">›</text>
  </view>

  <view class="container">
    <!-- 加载 / 错误 -->
    <view wx:if="{{loading}}" class="empty-state">
      <view class="empty-icon"><mbs-icon name="search" size="56" color="var(--text-tertiary)" /></view>
      <view class="empty-text">店铺加载中...</view>
    </view>

    <view wx:elif="{{error}}" class="card">
      <view class="card-subtitle" style="color: var(--danger);">{{error}}</view>
      <view class="btn btn-secondary" bindtap="loadShop">重新加载</view>
    </view>

    <block wx:elif="{{shop}}">
      <!-- 店铺主卡片 -->
      <view class="card shop-card">
        <swiper class="home-shop-gallery" indicator-dots="true" autoplay="false" catchtouchstart="noop">
          <swiper-item><image class="home-shop-image" src="/assets/shop/storefront.jpg" mode="aspectFill" aria-label="皓诗形象门头实景" /></swiper-item>
          <swiper-item><image class="home-shop-image" src="/assets/shop/service.jpg" mode="aspectFill" aria-label="皓诗形象店内服务实景" /></swiper-item>
        </swiper>
        <view class="shop-info">
          <view wx:if="{{shop.description}}" class="home-shop-description">{{shop.description}}</view>
          <view class="home-shop-details">
            <view class="home-shop-detail"><text class="home-shop-label">评分</text><view class="home-shop-value home-shop-rating"><text class="home-shop-score">{{shop.rating || '4.8'}} 分</text><text class="home-shop-reviews">{{reviewCount || 0}} 条评价</text></view></view>
            <view class="home-shop-detail"><text class="home-shop-label">地址</text><text class="home-shop-value">{{shop.address || '暂无地址'}}</text></view>
            <view wx:if="{{shop.phone}}" class="home-shop-detail" bindtap="callStore" role="button" aria-label="联系门店"><text class="home-shop-label">电话</text><view class="home-shop-value home-shop-contact"><text>{{shop.phone}}</text><text class="home-shop-contact-action">联系门店 ›</text></view></view>
            <view class="home-shop-detail"><text class="home-shop-label">营业时间</text><text class="home-shop-value">09:00–21:00</text></view>
          </view>
        </view>
      </view>

      <view class="card home-membership">
        <view class="card-title"><mbs-icon name="crown" size="32" color="var(--primary)" />会员体系 · 权益简介</view>
        <view class="membership-intro">购买 VIP 享等级权益，储值会员可叠加消费折扣。</view>
        <view class="membership-summary">
          <view class="membership-summary-item"><text class="membership-summary-title">购买 VIP</text><text>普卡 · 银卡 · 金卡 · 钻石</text><text>等级折扣、洗护赠礼等权益</text></view>
          <view class="membership-summary-item"><text class="membership-summary-title">储值会员</text><text>储值卡 · 安心卡 · 顺心卡 · 随心卡</text><text>不同储值档位，享折上折</text></view>
        </view>
        <view class="membership-toggle" bindtap="toggleMembershipDetails" role="button" aria-expanded="{{membershipExpanded}}">{{membershipExpanded ? '收起权益详情 −' : '查看各等级价格与权益 ＋'}}</view>
        <block wx:if="{{membershipExpanded}}">
          <view class="membership-table-title">购买 VIP 权益</view>
          <view class="membership-benefit-list">
            <view wx:for="{{vipBenefits}}" wx:key="feature" class="membership-benefit-card">
              <view class="membership-benefit-name">{{item.feature}}</view>
              <view class="membership-benefit-grid">
                <view class="membership-benefit-value"><text class="membership-benefit-level">普卡</text><text>{{item.bronze}}</text></view>
                <view class="membership-benefit-value"><text class="membership-benefit-level">银卡</text><text>{{item.silver}}</text></view>
                <view class="membership-benefit-value"><text class="membership-benefit-level">金卡</text><text>{{item.gold}}</text></view>
                <view class="membership-benefit-value"><text class="membership-benefit-level">钻石</text><text>{{item.diamond}}</text></view>
              </view>
            </view>
          </view>
          <view class="membership-table-title">储值会员权益（折上折）</view>
          <view class="membership-benefit-list">
            <view wx:for="{{storedBenefits}}" wx:key="feature" class="membership-benefit-card">
              <view class="membership-benefit-name">{{item.feature}}</view>
              <view class="membership-benefit-grid">
                <view class="membership-benefit-value"><text class="membership-benefit-level">储值卡</text><text>{{item.store500}}</text></view>
                <view class="membership-benefit-value"><text class="membership-benefit-level">安心卡</text><text>{{item.store1000}}</text></view>
                <view class="membership-benefit-value"><text class="membership-benefit-level">顺心卡</text><text>{{item.store2000}}</text></view>
                <view class="membership-benefit-value"><text class="membership-benefit-level">随心卡</text><text>{{item.store5000}}</text></view>
              </view>
            </view>
          </view>
          <view class="membership-intro">具体适用范围与权益以门店会员规则为准。</view>
        </block>
      </view>
        <!-- 邀请好友 -->
        <view wx:if="{{customer && isMember}}" class="index-invite-card" bindtap="goToInvite">
          <view class="index-invite-left">
            <view class="index-share-pulse">
              <mbs-icon name="share-2" size="40" color="#ffffff" />
            </view>
            <view class="index-invite-text">
              <view class="index-invite-title">邀请新顾客 · 一起变美</view>
              <view class="index-invite-hint">好友消费后，你可获得 {{(customer.referralBonusRate || 0.10) * 100}}% 奖励金，可用于店内消费</view>
            </view>
          </view>
          <view class="invite-action-label">立即邀请 ›</view>
        </view>
      <!-- 发型师团队 -->
      <view class="card" wx:if="{{stylists && stylists.length > 0}}">
        <view class="card-title">
          <mbs-icon name="award" size="32" color="var(--primary)" />
          发型师团队
        </view>
        <view
          wx:for="{{stylists}}"
          wx:key="id"
          class="stylist-card"
          bindtap="showStylistProfile"
          data-id="{{item.id}}"
        >
          <view class="stylist-avatar">
            <image wx:if="{{item.avatar}}" class="stylist-avatar-img" src="{{item.avatar}}" mode="aspectFill" />
            <mbs-icon wx:else name="user" size="36" color="var(--text-tertiary)" />
          </view>
          <view class="stylist-info">
            <view class="stylist-name-row">
              <view class="stylist-name">{{item.name}}</view>
              <view class="stylist-role-badges">
                <view wx:if="{{item.isGold}}" class="stylist-badge stylist-badge-gold"><image class="stylist-badge-icon" src="/assets/icons/medal.png" mode="aspectFit" /><text>金牌</text></view>
                <view wx:if="{{item.isManager}}" class="stylist-badge stylist-badge-manager"><image class="stylist-badge-icon" src="/assets/icons/crown.png" mode="aspectFit" /><text>店长</text></view>
              </view>
            </view>
            <view class="stylist-rating-line" wx:if="{{item.rating}}">
              <mbs-icon name="star" size="20" color="var(--warning)" />
              <text>{{item.rating}} 分</text>
            </view>
            <view class="stylist-specialty" wx:if="{{item.specialty}}">
              <mbs-icon name="sparkles" size="18" color="var(--primary)" />
              <text>{{item.specialty}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 服务项目（可滑动，与 H5 ShopDetail 对齐） -->
      <view class="card" wx:if="{{shop.services && shop.services.length > 0}}">
        <view class="card-title">
          <mbs-icon name="scissors" size="32" color="var(--accent)" />
          服务项目
          <text class="service-scroll-hint">滑动查看更多</text>
        </view>
        <scroll-view class="service-scroll" scroll-y="true" enhanced="true" show-scrollbar="true">
          <view
            wx:for="{{shop.services}}"
            wx:key="id"
            class="service-item-h5"
            bindtap="onServiceTap"
            data-id="{{item.id}}"
          >
            <view class="service-icon-h5">
              <mbs-icon name="scissors" size="36" color="var(--accent)" />
            </view>
            <view class="service-content-h5">
              <view class="service-name-h5">{{item.name}}</view>
              <view wx:if="{{item.description}}" class="service-desc-h5">{{item.description}}</view>
              <view wx:if="{{item.duration}}" class="service-duration-h5">
                <mbs-icon name="clock" size="18" color="var(--accent-dark)" />
                约 {{item.duration}} 分钟
              </view>
            </view>
            <view class="service-price-h5">
              <mbs-price current="{{item.price}}" size="sm" />
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 顾客评价 -->
      <view class="card" wx:if="{{reviews && reviews.length > 0}}">
        <view class="card-title">
          <mbs-icon name="messageSquare" size="32" color="var(--accent)" />
          顾客评价
          <text class="service-scroll-hint">{{reviewCount}} 条</text>
        </view>
        <view class="review-list">
          <view
            wx:for="{{reviews}}"
            wx:key="id"
            class="review-item"
          >
            <view class="review-header">
              <view class="review-avatar">
                <mbs-icon name="user" size="28" color="var(--text-tertiary)" />
              </view>
              <view class="review-meta">
                <view class="review-name">{{item.customerName || '匿名用户'}}</view>
                <view class="review-date">{{fmt.formatDate(item.createdAt)}}</view>
              </view>
              <view class="review-stars">
                <mbs-icon wx:for="{{item.starList}}" wx:for-item="star" wx:key="key" name="star" size="16" color="{{star.filled ? 'var(--warning)' : 'var(--gray-300)'}}" />
              </view>
            </view>
            <view class="review-comment">{{item.comment || '用户未填写文字评价'}}</view>
            <view wx:if="{{item.reply}}" class="review-reply">
              <view class="review-reply-header">
                <mbs-icon name="messageSquare" size="16" color="var(--accent)" />
                <text class="review-reply-by">{{item.replyBy || '店铺回复'}}</text>
                <text class="review-reply-date">{{fmt.formatDate(item.replyAt)}}</text>
              </view>
              <view class="review-reply-text">{{item.reply}}</view>
            </view>
          </view>
        </view>
      </view>
      <!-- 商品商城 -->
      <view class="card" wx:if="{{products && products.length > 0}}">
        <view class="card-title">
          <mbs-icon name="shoppingBag" size="32" color="var(--primary)" />
          商品商城
          <text class="service-scroll-hint" bindtap="goToProducts">查看全部 →</text>
        </view>
        <view class="product-grid">
          <view
            wx:for="{{products}}"
            wx:key="id"
            class="product-item"
            bindtap="goToProducts"
          >
            <view class="product-image">
              <mbs-icon wx:if="{{!item.images || item.images.length === 0}}" name="shoppingBag" size="48" color="var(--text-tertiary)" />
              <image wx:else class="product-image-img" src="{{item.images[0]}}" mode="aspectFill" />
            </view>
            <view class="product-name">{{item.name}}</view>
            <view class="product-price-row">
              <text wx:if="{{item.originalPrice && item.originalPrice > item.price}}" class="product-original-price">¥{{fmt.formatMoney(item.originalPrice)}}</text>
              <text class="product-price">¥{{fmt.formatMoney(item.price)}}</text>
            </view>
          </view>
        </view>
      </view>

    </block>
  </view>

  <privacy-modal
    bind:accept="onPrivacyAccept"
    bind:decline="onPrivacyDecline"
  />

  <!-- 发型师详细档案弹窗（背景模糊 + 放大照片） -->
  <view wx:if="{{selectedStylist}}" class="stylist-profile-mask" bindtap="closeStylistProfile">
    <view class="stylist-profile-card" catchtap="noop">
      <view class="stylist-profile-avatar">
        <image wx:if="{{selectedStylist.avatar}}" class="stylist-profile-avatar-img" src="{{selectedStylist.avatar}}" mode="aspectFill" />
        <mbs-icon wx:else name="user" size="72" color="var(--text-tertiary)" />
      </view>
      <view class="stylist-profile-name-row">
        <text class="stylist-profile-name">{{selectedStylist.name}}</text>
        <view wx:if="{{selectedStylist.isGold}}" class="stylist-badge stylist-badge-gold"><image class="stylist-badge-icon" src="/assets/icons/medal.png" mode="aspectFit" /><text>金牌</text></view>
        <view wx:if="{{selectedStylist.isManager}}" class="stylist-badge stylist-badge-manager"><image class="stylist-badge-icon" src="/assets/icons/crown.png" mode="aspectFit" /><text>店长</text></view>
      </view>
      <view class="stylist-profile-title" wx:if="{{selectedStylist.title}}">{{selectedStylist.title}}</view>
      <view class="stylist-profile-rating" wx:if="{{selectedStylist.rating}}">
        <mbs-icon name="star" size="30" color="var(--warning)" />
        <text>{{selectedStylist.rating}} 分</text>
      </view>
      <view class="stylist-profile-specialty" wx:if="{{selectedStylist.specialty}}">
        <view class="stylist-profile-section-label">擅长专长</view>
        <view class="stylist-profile-specialty-text">{{selectedStylist.specialty}}</view>
      </view>
      <view class="stylist-profile-close" bindtap="closeStylistProfile">关闭</view>
    </view>
  </view>
</view>
