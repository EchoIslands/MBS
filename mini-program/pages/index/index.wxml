<wxs src="../../utils/format.wxs" module="fmt" />
<view class="page index-page">
  <!-- 粘性白色头部 -->
  <view class="sticky-header">
    <view class="sticky-header-inner">
      <view class="sticky-header-title">{{shop.name || 'MBS 理发店'}}</view>
      <view class="sticky-header-actions">
        <view class="sticky-header-btn" bindtap="goToProfile">
          <mbs-icon name="user" size="28" color="#ffffff" />
          <text>个人中心</text>
        </view>
        <view class="sticky-header-btn-outline" bindtap="handleLogout">
          <mbs-icon name="logOut" size="28" color="#ef4444" />
          <text>退出</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载 / 错误 -->
  <view wx:if="{{loading}}" class="empty-state">
    <view class="empty-icon"><mbs-icon name="search" size="56" color="#9ca3af" /></view>
    <view class="empty-text">店铺加载中...</view>
  </view>

  <view wx:elif="{{error}}" class="card" style="margin: 32rpx;">
    <view class="card-title" style="color: #ef4444;">{{error}}</view>
    <view class="btn btn-primary" bindtap="loadShop">重新加载</view>
  </view>

  <block wx:elif="{{shop}}">
    <!-- Hero 图片轮播 -->
    <view class="image-carousel" wx:if="{{shop.images && shop.images.length > 0}}">
      <swiper class="carousel-swiper" indicator-dots="{{shop.images.length > 1}}" autoplay="{{true}}" interval="4000" circular="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff">
        <swiper-item wx:for="{{shop.images}}" wx:key="index">
          <image class="carousel-image" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </swiper>
    </view>

    <!-- 店铺信息卡片 -->
    <view class="shop-info-card">
      <view class="shop-info-header">
        <view class="shop-info-title-block">
          <view class="shop-name">{{shop.name}}</view>
          <view class="shop-rating-row">
            <view class="flex" style="gap: 4rpx;">
              <mbs-icon wx:for="{{ratingStars}}" wx:key="key" name="star" size="22" color="{{item.filled ? '#f59e0b' : '#d1d5db'}}" />
            </view>
            <text class="shop-rating-num">{{shop.rating || '4.8'}}</text>
            <text class="shop-review-count">({{reviewCount || 0}} 条评价)</text>
          </view>
        </view>
      </view>
      <view class="shop-info-divider"></view>
      <view class="shop-info-line">
        <mbs-icon name="mapPin" size="24" color="#6b7280" />
        <text>{{shop.address || '暂无地址'}}</text>
      </view>
      <view class="shop-info-line" wx:if="{{shop.phone}}">
        <mbs-icon name="phone" size="24" color="#6b7280" />
        <text>{{shop.phone}}</text>
      </view>
      <view class="shop-info-line">
        <mbs-icon name="clock" size="24" color="#6b7280" />
        <text>营业中 · 09:00-21:00</text>
      </view>
    </view>

    <!-- 发型师团队 -->
    <view class="card" wx:if="{{stylists && stylists.length > 0}}">
      <view class="card-title">
        <mbs-icon name="user" size="32" color="#2563eb" />
        发型师团队
      </view>
      <scroll-view class="stylist-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="stylist-track">
          <view
            wx:for="{{stylists}}"
            wx:key="id"
            class="stylist-card"
          >
            <view class="stylist-avatar">
              <mbs-icon name="user" size="40" color="#9ca3af" />
            </view>
            <view class="stylist-name">{{item.name}}</view>
            <view class="stylist-title" wx:if="{{item.title}}">{{item.title}}</view>
            <view class="stylist-rating" wx:if="{{item.rating}}">
              <mbs-icon name="star" size="18" color="#f59e0b" />
              <text>{{item.rating}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 商品商城 -->
    <view class="card" wx:if="{{products && products.length > 0}}">
      <view class="card-title-row">
        <view class="card-title" style="margin-bottom: 0;">
          <mbs-icon name="shoppingBag" size="32" color="#f59e0b" />
          商品商城
        </view>
        <view class="card-link" bindtap="goToProducts">查看全部 →</view>
      </view>
      <view class="product-grid">
        <view
          wx:for="{{products}}"
          wx:key="id"
          class="product-item"
          bindtap="goToProducts"
        >
          <view class="product-image">
            <image wx:if="{{item.images && item.images.length > 0}}" class="product-image-img" src="{{item.images[0]}}" mode="aspectFill" />
            <mbs-icon wx:else name="shoppingBag" size="48" color="#9ca3af" />
          </view>
          <view class="product-info">
            <view class="product-name">{{item.name}}</view>
            <view class="product-price-row">
              <text class="product-price">¥{{item.price}}</text>
              <text wx:if="{{item.originalPrice && item.originalPrice > item.price}}" class="product-original-price">¥{{item.originalPrice}}</text>
              <view wx:if="{{item.originalPrice && item.originalPrice > item.price}}" class="product-member-badge">
                <mbs-icon name="crown" size="16" color="#d97706" />
                <text>会员价</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 服务项目 -->
    <view class="card" wx:if="{{shop.services && shop.services.length > 0}}">
      <view class="card-title">
        <mbs-icon name="scissors" size="32" color="#f59e0b" />
        服务项目
      </view>
      <view>
        <view
          wx:for="{{shop.services}}"
          wx:key="id"
          class="service-item"
          bindtap="onServiceTap"
          data-id="{{item.id}}"
        >
          <view class="service-icon">
            <mbs-icon name="scissors" size="40" color="#f59e0b" />
          </view>
          <view class="service-info">
            <view class="service-name">{{item.name}}</view>
            <view wx:if="{{item.description}}" class="service-desc">{{item.description}}</view>
            <view wx:if="{{item.duration}}" class="service-duration">
              <mbs-icon name="clock" size="18" color="#b45309" />
              约 {{item.duration}} 分钟
            </view>
          </view>
          <view class="service-price">¥{{item.price}}</view>
        </view>
      </view>
    </view>

    <!-- 顾客评价 -->
    <view class="card" wx:if="{{reviews && reviews.length > 0}}">
      <view class="card-title-row">
        <view class="card-title" style="margin-bottom: 0;">
          <mbs-icon name="messageSquare" size="32" color="#f59e0b" />
          顾客评价
        </view>
        <view class="card-link">{{reviewCount}} 条</view>
      </view>

      <view class="review-item" wx:for="{{reviews}}" wx:key="id">
        <view class="review-header">
          <view class="review-avatar">
            <mbs-icon name="user" size="28" color="#9ca3af" />
          </view>
          <view class="review-info">
            <view class="review-name">{{item.customerName || '匿名用户'}}</view>
            <view class="review-date">{{fmt.formatDate(item.createdAt)}}</view>
          </view>
          <view class="review-stars">
            <mbs-icon wx:for="{{item.starList}}" wx:for-item="star" wx:key="key" name="star" size="16" color="{{star.filled ? '#f59e0b' : '#d1d5db'}}" />
          </view>
        </view>
        <view class="review-comment">{{item.comment || '用户未填写文字评价'}}</view>
        <view wx:if="{{item.reply}}" class="review-reply">
          <view class="review-reply-header">
            <mbs-icon name="messageSquare" size="16" color="#f59e0b" />
            <text class="review-reply-by">{{item.replyBy || '店铺回复'}}</text>
          </view>
          <view class="review-reply-text">{{item.reply}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 底部固定操作栏 -->
  <view class="fixed-bottom-bar" wx:if="{{shop}}">
    <view class="bottom-actions">
      <view class="bottom-btn bottom-btn-store" bindtap="goToProducts">
        <view class="bottom-btn-icon">
          <mbs-icon name="shoppingBag" size="36" color="#b45309" />
        </view>
        <view class="bottom-btn-text">商品商城</view>
      </view>
      <view class="bottom-btn bottom-btn-booking" bindtap="goToBooking">
        <view class="bottom-btn-icon">
          <mbs-icon name="clock" size="36" color="#ffffff" />
        </view>
        <view class="bottom-btn-text">立即预约</view>
      </view>
    </view>
  </view>

  <login-modal
    visible="{{showLogin}}"
    bind:success="onLoginSuccess"
    bind:close="onLoginClose"
  />
</view>