/* ===== 页面布局 ===== */
.index-page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom, 0));
  background: var(--bg);
}

/* ===== Hero 图片轮播 ===== */
.image-carousel {
  margin: 32rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.carousel-swiper {
  width: 100%;
  height: 400rpx;
}

.carousel-image {
  width: 100%;
  height: 100%;
}

/* ===== 店铺信息卡片 ===== */
.shop-info-card {
  background: var(--card-bg);
  border-radius: 32rpx;
  padding: 48rpx;
  margin: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.shop-info-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.shop-info-title-block {
  flex: 1;
  min-width: 0;
}

.shop-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-rating-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.shop-rating-num {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.shop-review-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.shop-info-divider {
  height: 2rpx;
  background: var(--gray-100);
  margin: 28rpx 0 24rpx;
}

.shop-info-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.shop-info-line:last-child {
  margin-bottom: 0;
}

/* ===== 发型师团队 —— 横向滚动卡片 ===== */
.stylist-scroll {
  width: 100%;
  white-space: nowrap;
  margin: 0 -16rpx;
  padding: 0 16rpx;
}

.stylist-track {
  display: inline-flex;
  gap: 24rpx;
  padding: 8rpx 0 16rpx;
}

.stylist-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  padding: 28rpx 20rpx;
  background: var(--gray-50);
  border-radius: 24rpx;
  border: 1rpx solid var(--gray-100);
  gap: 12rpx;
  vertical-align: top;
}

.stylist-avatar {
  width: 96rpx;
  height: 96rpx;
  background: var(--gray-100);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stylist-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.stylist-title {
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.stylist-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ===== 商品商城 —— 2列网格 ===== */
.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.product-item {
  background: var(--gray-50);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--gray-100);
  transition: box-shadow 0.15s;
}

.product-item:active {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.product-image {
  width: 100%;
  height: 280rpx;
  background: var(--gray-100);
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-image-img {
  width: 100%;
  height: 100%;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.product-price-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.product-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent);
}

.product-original-price {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.product-member-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  background: var(--amber-50);
  color: var(--accent-dark);
  border-radius: 9999rpx;
  font-size: 18rpx;
  font-weight: 500;
}

/* ===== 服务项目 ===== */
.service-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  background: var(--gray-50);
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--gray-100);
}

.service-item:last-child {
  margin-bottom: 0;
}

.service-icon {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, var(--amber-100), #ffdcc2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.service-info {
  flex: 1;
  min-width: 0;
}

.service-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.service-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.service-duration {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--accent-dark);
  background: var(--amber-50);
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
  font-weight: 500;
}

.service-price {
  text-align: right;
  margin-left: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid var(--gray-100);
  font-size: 34rpx;
  font-weight: 700;
  color: var(--accent);
}

/* ===== 顾客评价 ===== */
.review-item {
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid var(--gray-100);
}

.review-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.review-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.review-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--gray-100);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.review-info {
  flex: 1;
  min-width: 0;
}

.review-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.review-date {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.review-stars {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.review-comment {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.review-reply {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--gray-50);
  border-radius: 20rpx;
  border-left: 6rpx solid var(--accent);
}

.review-reply-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.review-reply-by {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.review-reply-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ===== 粘性头部（与 app.scss 对齐，此处补充微调） ===== */
.index-page .sticky-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* ===== 卡片间距统一 ===== */
.index-page .card:first-of-type,
.index-page .shop-info-card:first-of-type {
  margin-top: 0;
}

/* ===== 商品图片高度覆盖 ===== */
.index-page .product-image {
  height: 260rpx;
}