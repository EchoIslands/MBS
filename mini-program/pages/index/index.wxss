/* ===== 页面布局 ===== */
.index-page {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom, 0));
  background: var(--bg);
}

/* ===== Hero 图片轮播 ===== */
.image-carousel {
  margin: 32rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.carousel-swiper {
  width: 100%;
  height: 400rpx;
}

.carousel-image {
  width: 100%;
  height: 100%;
}

/* ===== 店铺信息卡片 ===== */
.shop-info-card {
  background: var(--card-bg);
  border-radius: 32rpx;
  padding: 48rpx;
  margin: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.shop-info-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.shop-info-title-block {
  flex: 1;
  min-width: 0;
}

.shop-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-rating-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.shop-rating-num {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.shop-review-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.shop-info-divider {
  height: 2rpx;
  background: var(--gray-100);
  margin: 28rpx 0 24rpx;
}

.shop-info-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
  margin-bottom: 12rpx;
}

.shop-info-line:last-child {
  margin-bottom: 0;
}

/* ===== 发型师团队 —— 横向滚动卡片 ===== */
.stylist-scroll {
  width: 100%;
  white-space: nowrap;
  margin: 0 -16rpx;
  padding: 0 16rpx;
}

.stylist-track {
  display: inline-flex;
  gap: 24rpx;
  padding: 8rpx 0 16rpx;
}

.stylist-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 280rpx;
  padding: 28rpx 22rpx;
  background: var(--gray-50);
  border-radius: 24rpx;
  border: 1rpx solid var(--gray-100);
  gap: 12rpx;
  vertical-align: top;
}

.stylist-avatar {
  width: 96rpx;
  height: 96rpx;
  background: var(--gray-100);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stylist-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.stylist-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 100%;
}

.stylist-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 70%;
}

.stylist-title {
  font-size: 22rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
  margin-top: 4rpx;
}

.stylist-specialty {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-primary);
  background: #ffffff;
  border-radius: 16rpx;
  padding: 14rpx 16rpx;
  margin-top: 12rpx;
  width: 100%;
  box-sizing: border-box;
  text-align: left;
}

.stylist-specialty mbs-icon {
  margin-right: 6rpx;
  vertical-align: -2rpx;
}

.stylist-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
}

/* ===== 商品商城 —— 2列网格 ===== */
.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.product-item {
  background: var(--gray-50);
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid var(--gray-100);
  transition: box-shadow 0.15s;
}

.product-item:active {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.product-image {
  width: 100%;
  height: 280rpx;
  background: var(--gray-100);
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-image-img {
  width: 100%;
  height: 100%;
}

.product-info {
  padding: 20rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.product-price-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.product-price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent);
}

.product-original-price {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.product-member-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  background: var(--amber-50);
  color: var(--accent-dark);
  border-radius: 9999rpx;
  font-size: 18rpx;
  font-weight: 500;
}

/* ===== 服务项目 ===== */
.service-scroll {
  max-height: 480rpx;
}

.service-item-h5 {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  background: var(--gray-50);
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--gray-100);
}

.service-item-h5:last-child {
  margin-bottom: 0;
}

.service-icon-h5 {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, var(--amber-100), #ffdcc2);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.service-content-h5 {
  flex: 1;
  min-width: 0;
}

.service-name-h5 {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.service-desc-h5 {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.service-duration-h5 {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--accent-dark);
  background: var(--amber-50);
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
  font-weight: 500;
}

.service-price-h5 {
  text-align: right;
  margin-left: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid var(--gray-100);
}

/* ===== 顾客评价 ===== */
.review-item {
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid var(--gray-100);
}

.review-item:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.review-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.review-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--gray-100);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.review-info {
  flex: 1;
  min-width: 0;
}

.review-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.review-date {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.review-stars {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.review-comment {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.review-reply {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--gray-50);
  border-radius: 20rpx;
  border-left: 6rpx solid var(--accent);
}

.review-reply-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.review-reply-by {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.review-reply-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ===== 粘性头部（与 app.scss 对齐，此处补充微调） ===== */
.index-page .sticky-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* ===== 卡片间距统一 ===== */
.index-page .card:first-of-type,
.index-page .shop-info-card:first-of-type {
  margin-top: 0;
}

/* ===== 商品图片高度覆盖 ===== */
.index-page .product-image {
  height: 260rpx;
}

/* ===== 会员信息头 ===== */
.member-header {
  position: relative;
  overflow: hidden;
  color: #fff;
  border-radius: 32rpx;
  margin-bottom: 32rpx;
  padding: 40rpx 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.1);
}

.gradient-member-regular {
  background: linear-gradient(135deg, #9ca3af, #6b7280);
}

.gradient-member-bronze {
  background: linear-gradient(135deg, #fb923c, #f97316);
}

.gradient-member-silver {
  background: linear-gradient(135deg, #60a5fa, #2563eb);
}

.gradient-member-gold {
  background: linear-gradient(135deg, #facc15, #ca8a04);
}

.gradient-member-diamond {
  background: linear-gradient(135deg, #a855f7, #ec4899, #f97316);
}

.member-decor {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.member-decor-1 {
  width: 280rpx;
  height: 280rpx;
  right: -60rpx;
  top: -60rpx;
}

.member-decor-2 {
  width: 220rpx;
  height: 220rpx;
  right: -100rpx;
  top: 60rpx;
  background: rgba(255, 255, 255, 0.05);
}

.member-decor-3 {
  width: 140rpx;
  height: 140rpx;
  left: 24rpx;
  bottom: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  filter: blur(16rpx);
}

.member-header-inner {
  position: relative;
  z-index: 1;
}

.member-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.member-info-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.member-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-identity {
  display: flex;
  flex-direction: column;
}

.member-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
}

.member-phone {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.member-info-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.member-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  font-size: 24rpx;
  font-weight: 500;
}

.member-badge-sub {
  padding: 8rpx 14rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 22rpx;
}

.member-discount-card {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8rpx);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.member-discount-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 10rpx;
}

.member-discount-value {
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 8rpx;
}

.member-discount-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.4;
}

.member-stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.member-stat-item {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8rpx);
  border-radius: 24rpx;
  padding: 22rpx;
}

.member-stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 8rpx;
}

.member-stat-value {
  font-size: 34rpx;
  font-weight: 700;
}

.member-invite-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  padding: 26rpx 0;
  background: linear-gradient(135deg, #ff7a18, #ff2e63);
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(255, 46, 99, 0.25);
}