<view class="booking-page {{tabTransitionClass}}" bindtouchstart="onTabSwipeStart" bindtouchend="onTabSwipeEnd" bindtouchcancel="onTabSwipeCancel">
  <view class="container">
    <!-- ========== Loading ========== -->
    <view wx:if="{{loading}}" class="empty-state">
      <view class="empty-icon"><mbs-icon name="search" size="56" color="var(--text-tertiary)" /></view>
      <view class="empty-text">店铺加载中...</view>
    </view>

    <!-- ========== Error ========== -->
    <view wx:elif="{{error}}" class="card">
      <view class="card-subtitle" style="color: var(--danger);">{{error}}</view>
      <view class="btn btn-secondary" bindtap="loadShop">重新加载</view>
    </view>

    <block wx:elif="{{shop}}">
      <!-- ========== 3) 股东权益卡（条件渲染） ========== -->
      <view wx:if="{{stockholderSummary.isStockholder && stockholderSummary.enabled}}" class="card stockholder-card">
        <view class="stockholder-title">
          <mbs-icon name="award" size="34" color="var(--amber-600)" />
          股东会员专享权益
        </view>
        <view class="stockholder-benefits">
          <view wx:for="{{stockholderSummary.benefits}}" wx:key="*this" class="stockholder-tag">
            {{item}}
          </view>
        </view>
      </view>

      <!-- ========== 4) 服务选择卡 ========== -->
      <view class="card">
        <view class="card-header">
          <mbs-icon name="scissors" size="36" color="var(--accent)" />
          <text class="card-header-text">选择服务</text>
        </view>

        <view class="service-scroll-wrap">
          <scroll-view
            id="serviceScroll"
            class="service-scroll"
            scroll-y="true"
            enhanced="true"
            show-scrollbar="false"
            bindscroll="onServiceScroll"
          >
            <view
              wx:for="{{shop.services}}"
              wx:key="id"
              class="service-item {{selectedService === item.id ? 'service-item-active' : ''}}"
              bindtap="onServiceSelect"
              data-id="{{item.id}}"
            >
              <view class="service-radio">
                <view wx:if="{{selectedService === item.id}}" class="service-radio-inner"></view>
              </view>

              <view class="service-icon-wrap">
                <mbs-icon name="scissors" size="32" color="var(--amber-600)" />
              </view>

              <view class="service-main">
                <view class="service-top-row">
                  <view class="service-name">{{item.name}}</view>
                  <view wx:if="{{item.isStockholderDiscount}}" class="service-price-box">
                    <view wx:if="{{item.hasDiscount}}" class="service-price-original">¥{{item.originalPriceStr}}</view>
                    <view class="service-price-row">
                      <view class="service-price-tag tag-amber">股东价</view>
                      <view class="service-price-current">¥{{item.priceStr}}</view>
                    </view>
                  </view>
                  <view wx:else class="service-price-box">
                    <view wx:if="{{item.hasDiscount}}" class="service-price-original">¥{{item.originalPriceStr}}</view>
                    <view class="service-price-row">
                      <view wx:if="{{item.hasDiscount}}" class="service-price-tag tag-orange">会员价</view>
                      <view class="service-price-current">¥{{item.priceStr}}</view>
                    </view>
                  </view>
                </view>
                <view class="service-bottom-row">
                  <view wx:if="{{item.duration}}" class="service-duration">
                    <mbs-icon name="clock" size="18" color="var(--accent-dark)" />
                    <text>约 {{item.duration}} 分钟</text>
                  </view>
                  <view wx:if="{{item.description}}" class="service-desc">{{item.description}}</view>
                </view>
              </view>
            </view>
          </scroll-view>

          <view class="custom-scrollbar" wx:if="{{showServiceScrollbar}}">
            <view class="custom-scrollbar-track">
              <view class="custom-scrollbar-thumb" style="top: {{serviceThumbTop}}px; height: {{serviceThumbHeight}}px;"></view>
            </view>
          </view>
        </view>

        <view wx:if="{{!shop.services || shop.services.length === 0}}" class="empty-hint">暂无可用服务</view>
      </view>

      <!-- ========== 5) 日期选择卡 ========== -->
      <view class="card">
        <view class="card-header">
          <mbs-icon name="calendar" size="36" color="var(--primary)" />
          <text class="card-header-text">选择日期</text>
        </view>
        <scroll-view class="date-scroll" scroll-x="true" show-scrollbar="false" enhanced="true" catchtouchstart="ignoreTabSwipe">
          <view class="date-scroll-inner">
            <view
              wx:for="{{dates}}"
              wx:key="value"
              class="date-chip {{selectedDate === item.value ? 'date-chip-active' : ''}}"
              bindtap="onDateSelect"
              data-value="{{item.value}}"
            >
              <view class="date-chip-label">{{item.label}}</view>
              <view class="date-chip-week">{{item.weekDay}}</view>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- ========== 6) 时间选择卡 ========== -->
      <view class="card">
        <view class="card-header">
          <mbs-icon name="clock" size="36" color="var(--primary)" />
          <text class="card-header-text">选择到店时间</text>
        </view>
        <view class="time-grid">
          <view
            wx:for="{{timeSlots}}"
            wx:key="time"
            class="time-chip {{selectedTime === item.time ? 'time-chip-active' : ''}} {{item.full ? 'time-chip-disabled' : ''}}"
            bindtap="onTimeSelect"
            data-value="{{item.time}}"
          >
            <text>{{item.time}}</text>
            <view wx:if="{{item.full}}" class="time-chip-tag">已满</view>
          </view>
        </view>
      </view>

      <!-- ========== 7) 发型师选择卡 ========== -->
      <view class="card">
        <view class="card-header">
          <mbs-icon name="scissors" size="36" color="var(--accent)" />
          <text class="card-header-text">选择发型师</text>
        </view>

        <!-- 智能匹配 -->
        <view
          class="barber-card barber-card-smart {{selectionMode === 'fastest' ? 'barber-card-smart-active' : ''}}"
          bindtap="onModeSelect"
          data-mode="fastest"
        >
          <view class="barber-radio">
            <view wx:if="{{selectionMode === 'fastest'}}" class="barber-radio-inner barber-radio-inner-green"></view>
          </view>
          <view class="barber-avatar barber-avatar-green">
            <mbs-icon name="zap" size="40" color="var(--green-600)" />
          </view>
          <view class="barber-info">
            <view class="barber-name-row">
              <text class="barber-name">智能匹配 · 推荐发型师</text>
              <text class="tag tag-green">推荐</text>
            </view>
            <view class="barber-desc">按所选服务和时段推荐发型师，等待以到店现场为准</view>
            <view wx:if="{{fastest}}" class="barber-meta-row">
              <text class="tag tag-gray">{{fastest.name}}</text>
              <text class="barber-wait barber-wait-ok">到店后动态更新等待</text>
            </view>
            <view wx:else class="barber-meta-row">
              <text class="barber-wait barber-wait-pending">正在计算...</text>
            </view>
          </view>
        </view>

        <!-- 分隔线 -->
        <view class="divider">
          <view class="divider-line"></view>
          <text class="divider-text">或选择指定发型师</text>
          <view class="divider-line"></view>
        </view>

        <!-- 发型师列表 -->
        <view
          wx:for="{{stylists}}"
          wx:key="id"
          class="barber-card {{(selectionMode === 'specific' && selectedBarberId === item.id) ? 'barber-card-selected' : ''}} {{(!item.isAvailable || !item.eligible) ? 'barber-card-busy' : ''}}"
          bindtap="onBarberSelect"
          data-id="{{item.id}}"
        >
          <view class="barber-radio">
            <view wx:if="{{selectionMode === 'specific' && selectedBarberId === item.id}}" class="barber-radio-inner"></view>
          </view>

          <view class="barber-avatar barber-avatar-orange" catchtap="showStylistProfile" data-id="{{item.id}}">
            <image wx:if="{{item.avatar}}" class="barber-avatar-img" src="{{item.avatar}}" mode="aspectFill" />
            <mbs-icon wx:else name="user" size="36" color="var(--text-tertiary)" />
          </view>

          <view class="barber-info">
            <view class="barber-name-row">
              <text class="barber-name" catchtap="showStylistProfile" data-id="{{item.id}}">{{item.name}}</text>
              <view wx:if="{{item.isGold}}" class="stylist-badge stylist-badge-gold"><image class="stylist-badge-icon" src="/assets/icons/medal.png" mode="aspectFit" /><text>金牌</text></view>
              <view wx:if="{{item.isShopManager}}" class="stylist-badge stylist-badge-manager"><image class="stylist-badge-icon" src="/assets/icons/crown.png" mode="aspectFit" /><text>店长</text></view>
              <text wx:if="{{!item.isAvailable}}" class="tag tag-red">已约</text>
              <text wx:if="{{item.requireGold && !item.eligible}}" class="tag tag-red">该服务需金牌发型师</text>
              <text wx:if="{{item.requireShopManager && !item.eligible}}" class="tag tag-red">该服务需店长</text>
            </view>

            <view class="barber-rating-row">
              <view class="rating-value">
                <mbs-icon name="award" size="24" color="var(--amber-400)" />
                <text>{{item.displayRating}}</text>
              </view>
              <view class="services-count">
                <mbs-icon name="user" size="24" color="var(--text-tertiary)" />
                <text>{{item.totalServices || 200}}+次</text>
              </view>
            </view>

            <view wx:if="{{item.tagsDisplay && item.tagsDisplay.length > 0}}" class="barber-tags">
              <text wx:for="{{item.tagsDisplay}}" wx:for-item="tag" wx:key="*this" class="tag tag-gray-sm">#{{tag}}</text>
              <text wx:if="{{item.tags.length > 2}}" class="tags-more">+{{item.tags.length - 2}}</text>
            </view>

            <view class="barber-wait-row">
              <text wx:if="{{item.isAvailable}}" class="barber-wait barber-wait-ok">此时段可预约，到店后确认等待</text>
              <text wx:else class="barber-wait barber-wait-busy">当前时段已满</text>
            </view>
          </view>
        </view>
      </view>

      <view class="booking-policy">每人最多保留2个未完成预约，同一天1个。提前2小时可正常取消或改期；临时变更单独记录，不直接算爽约。未到店由门店联系核实后确认，多次爽约将限制自助预约；会员与余额不受影响。预约为到店时段，不保证准时开始服务。</view>
      <!-- ========== 8) 备注卡 ========== -->
      <view class="card">
        <view class="card-header">
          <mbs-icon name="sparkles" size="36" color="var(--text-primary)" />
          <text class="card-header-text">备注（可选）</text>
        </view>
        <textarea
          class="notes-textarea"
          placeholder="您的发型偏好、特殊需求等..."
          value="{{notes}}"
          bindinput="onNotesInput"
          maxlength="200"
        />
      </view>

      <!-- 底部占位 -->
      <view class="bottom-spacer"></view>
    </block>
  </view>

  <!-- ========== 9) 固定底部栏 ========== -->
  <view class="booking-queue-rules">预约时间为到店时间段，非保证开剪时间。到店请前台确认；暂离请登记，叫号后保留10分钟。实际等待以排队页和现场确认动态更新。</view>
  <view class="fixed-bottom-bar" wx:if="{{shop}}">
    <view class="bar-inner">
      <view class="bar-price-area">
        <view class="bar-price-label">合计</view>
        <view class="bar-price-value">
          <view wx:if="{{selectedServicePrice > 0}}" class="bar-price-current">¥{{selectedServicePrice}}</view>
          <view wx:else class="bar-price-placeholder">请选择服务</view>
        </view>
      </view>
      <view class="bar-btn {{booking ? 'bar-btn-disabled' : ''}}" bindtap="handleBooking">
        <text>{{booking ? '预约中...' : '确认预约'}}</text>
      </view>
    </view>
  </view>

  <login-modal
    visible="{{showLogin}}"
    bind:success="onLoginSuccess"
    bind:close="onLoginClose"
  />

  <!-- 发型师详细档案弹窗（背景模糊 + 放大照片） -->
  <view wx:if="{{selectedStylist}}" class="stylist-profile-mask" bindtap="closeStylistProfile">
    <view class="stylist-profile-card" catchtap="noop">
      <view class="stylist-profile-avatar">
        <image wx:if="{{selectedStylist.avatar}}" class="stylist-profile-avatar-img" src="{{selectedStylist.avatar}}" mode="aspectFill" />
        <mbs-icon wx:else name="user" size="72" color="var(--text-tertiary)" />
      </view>
      <view class="stylist-profile-name-row">
        <text class="stylist-profile-name">{{selectedStylist.name}}</text>
        <view wx:if="{{selectedStylist.isGold}}" class="stylist-badge stylist-badge-gold"><image class="stylist-badge-icon" src="/assets/icons/medal.png" mode="aspectFit" /><text>金牌</text></view>
        <view wx:if="{{selectedStylist.isShopManager}}" class="stylist-badge stylist-badge-manager"><image class="stylist-badge-icon" src="/assets/icons/crown.png" mode="aspectFit" /><text>店长</text></view>
      </view>
      <view class="stylist-profile-title" wx:if="{{selectedStylist.title}}">{{selectedStylist.title}}</view>
      <view class="stylist-profile-rating" wx:if="{{selectedStylist.rating}}">
        <mbs-icon name="star" size="30" color="var(--warning)" />
        <text>{{selectedStylist.rating}} 分</text>
      </view>
      <view class="stylist-profile-specialty" wx:if="{{selectedStylist.specialty}}">
        <view class="stylist-profile-section-label">擅长专长</view>
        <view class="stylist-profile-specialty-text">{{selectedStylist.specialty}}</view>
      </view>
      <view class="stylist-profile-close" bindtap="closeStylistProfile">关闭</view>
    </view>
  </view>
</view>
