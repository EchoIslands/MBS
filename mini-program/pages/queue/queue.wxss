.live-queue-page { min-height:100vh; box-sizing:border-box; padding:28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); background:var(--bg); color:var(--text-primary); font-size:27rpx; line-height:1.7; }
.live-queue-top { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-bottom:24rpx; }
.live-queue-title { font-size:36rpx; font-weight:700; }
.queue-panel { background:#fffdf9; border:1rpx solid var(--border); border-radius:24rpx; padding:28rpx; margin-bottom:24rpx; }
.queue-sync,.queue-message,.queue-warning { padding:20rpx; border-radius:16rpx; margin-bottom:20rpx; font-size:25rpx; background:#fff4e5; }
.queue-sync { background:#fffdf9; color:var(--text-secondary); }
.queue-sync-stale,.queue-warning { background:#fff0eb; color:#9b4434; }
.queue-muted { color:var(--text-secondary); font-size:24rpx; }
.queue-state { font-size:38rpx; font-weight:700; margin:12rpx 0; }
.queue-estimate { padding:24rpx; border-radius:18rpx; background:#fff3e5; margin:24rpx 0; }
.queue-estimate-value { font-size:35rpx; font-weight:700; line-height:1.5; margin:8rpx 0; }
.queue-callout { border:2rpx solid #e5a774; border-radius:18rpx; padding:24rpx; background:#fff0dc; font-weight:700; margin-bottom:24rpx; }
.queue-actions { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:16rpx; margin-top:24rpx; }
.queue-primary,.queue-secondary { margin:0; padding:20rpx 16rpx; border-radius:16rpx; font-size:26rpx; line-height:1.6; font-weight:600; width:100%; box-sizing:border-box; }
.queue-primary { background:linear-gradient(135deg,var(--action-start),var(--action-end)); color:var(--on-action); }
.queue-secondary { background:#fff6eb; color:var(--text-primary); border:1rpx solid var(--primary-border); }
.queue-primary::after,.queue-secondary::after { border:0; }
.queue-primary[disabled],.queue-secondary[disabled] { opacity:.45; }
.queue-callout .queue-primary { margin-top:20rpx; }
.live-queue-top .queue-secondary { width:auto; }
.queue-wide { grid-column:span 2; }
.queue-section-title { font-size:30rpx; font-weight:700; margin-bottom:18rpx; }
.queue-notice { padding:18rpx 0; border-bottom:1rpx solid var(--border); }
.queue-notice:last-child { border-bottom:0; }
.queue-footnote { margin-top:20rpx; }
