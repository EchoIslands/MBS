<view class="live-queue-page">
 <view class="live-queue-top"><text class="live-queue-title">我的排队</text><button class="queue-secondary" bindtap="onRefresh">立即刷新</button></view>
 <view class="queue-sync {{stale ? 'queue-sync-stale' : ''}}">{{stale ? '同步尚未完成或已中断，旧数据不能代表现场顺序' : '页面开启时约每5秒同步'}} · 上次成功 {{lastSyncLabel}}</view>
 <view wx:if="{{error}}" class="queue-warning">{{error}}</view>
 <view wx:if="{{message}}" class="queue-message">{{message}}</view>
 <view wx:if="{{loading}}" class="queue-panel">正在同步门店现场…</view>
 <view wx:if="{{booking}}" class="queue-panel">
  <view class="queue-muted">{{booking.serviceName}} · {{booking.stylistName}}</view>
  <view class="queue-state">{{booking.stateLabel}}</view>
  <view class="queue-muted">预约到店 {{booking.scheduledDate}} {{booking.timeSlot}}</view>
  <view class="queue-estimate"><view class="queue-muted">预计等待范围</view><view class="queue-estimate-value">{{booking.estimateLabel}}</view><view>{{booking.aheadCount === null ? '到店后请前台确认加入现场队列' : '前方 '+booking.aheadCount+' 位 · 已签到等待 '+booking.waitMinutes+' 分钟'}}</view></view>
  <view wx:if="{{booking.state === 'called'}}" class="queue-callout"><view>请到服务位，叫号保留至 {{deadlineLabel}}</view><button class="queue-primary" disabled="{{stale || busy}}" bindtap="act" data-action="acknowledged">我已看到，正在到服务位</button></view>
  <view wx:if="{{booking.prepareReturn}}" class="queue-message">请准备返回门店，此提示不代表立即开始服务。</view>
  <view wx:if="{{booking.returnRequestedAt}}" class="queue-message">已报返回，请到前台确认；确认前不自动加入可服务队列。</view>
  <view wx:if="{{booking.expectedReturnAt}}" class="queue-muted">登记预计返回 {{returnLabel}}</view>
  <view wx:if="{{booking.overWait}}" class="queue-warning">等待已超过45分钟，可请前台协助换人、改约或确认进度。</view>
  <view class="queue-actions">
   <button wx:if="{{booking.canLeave}}" class="queue-secondary" disabled="{{stale || busy}}" bindtap="act" data-action="left_reported" data-minutes="10">暂离10分钟</button>
   <button wx:if="{{booking.canLeave}}" class="queue-secondary" disabled="{{stale || busy}}" bindtap="act" data-action="left_reported" data-minutes="20">暂离20分钟</button>
   <button wx:if="{{booking.canReturn}}" class="queue-primary queue-wide" disabled="{{stale || busy}}" bindtap="act" data-action="return_requested">我已返回，请前台确认</button>
   <button wx:if="{{booking.canAskHelp}}" class="queue-secondary" disabled="{{stale || busy}}" bindtap="act" data-action="help_requested">请前台协助</button>
   <button wx:if="{{contactPhone}}" class="queue-secondary" bindtap="callStore">直接致电门店</button>
  </view>
 </view>
 <view wx:if="{{booking}}" class="queue-panel"><view class="queue-section-title">现场消息</view><view wx:if="{{!notices.length}}" class="queue-muted">暂无新的叫号消息</view><view wx:for="{{notices}}" wx:key="id" class="queue-notice"><view class="queue-muted">{{item.timeLabel}} · {{item.acknowledged ? '已确认' : '现场更新'}}</view><view>{{item.message}}</view></view></view>
 <view wx:if="{{notificationTemplate}}" class="queue-panel"><button class="queue-primary" loading="{{notificationBusy}}" disabled="{{notificationBusy}}" bindtap="enableNotifications">开启微信排队提醒</button><view class="queue-muted">每次授权可发送一次提醒；微信不可用时转短信，未确认时前台电话联系。</view></view>
 <view class="queue-panel"><view class="queue-section-title">等待与过号规则</view><view>{{rules || '到店请先到前台确认，预约时间为到店时间段。'}}</view><view class="queue-muted queue-footnote">离开小程序、锁屏或断网时无法保证页面提醒及时送达。请保持电话畅通，临近轮到时返回门店。</view></view>
</view>
