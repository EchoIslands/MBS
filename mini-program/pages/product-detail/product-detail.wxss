.detail-page {
  min-height: 100vh;
  background: var(--gray-50);
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.sticky-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.sticky-header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.header-icon-btn-wrap {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.sticky-header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gray-800);
}

.header-cart-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 16rpx;
}

.cart-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  background: var(--danger);
  color: #fff;
  font-size: 20rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.detail-loading,
.detail-empty {
  text-align: center;
  padding: 160rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
  background: var(--gray-100);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid var(--gray-200);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.detail-image-card {
  background: #fff;
  padding: 24rpx;
}

.detail-image-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--gray-100);
}

.detail-image {
  width: 100%;
  height: 100%;
}

.detail-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gray-100);
}

.detail-tags {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  display: flex;
  gap: 12rpx;
}

.detail-tag {
  padding: 8rpx 24rpx;
  background: var(--danger);
  color: #fff;
  font-size: 22rpx;
  border-radius: 9999rpx;
  font-weight: 500;
}

.detail-info-card {
  background: #fff;
  margin: 24rpx;
  padding: 48rpx;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.detail-name {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--gray-800);
  line-height: 1.35;
}

.detail-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.detail-rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--gray-600);
}

.detail-sales {
  font-size: 26rpx;
  color: var(--gray-400);
}

.detail-price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 32rpx;
  flex-wrap: wrap;
}

.detail-price {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--danger);
  line-height: 1.2;
}

.detail-original-price {
  font-size: 28rpx;
  color: var(--gray-400);
  text-decoration: line-through;
}

.detail-vip-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  background: var(--amber-50);
  color: var(--accent-dark);
  font-size: 22rpx;
  border-radius: 9999rpx;
  font-weight: 500;
}

.detail-stock {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--gray-500);
}

.detail-section {
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--gray-100);
}

.detail-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gray-800);
  margin-bottom: 16rpx;
}

.detail-desc {
  font-size: 28rpx;
  color: var(--gray-600);
  line-height: 1.7;
  white-space: pre-line;
}

.detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid var(--gray-200);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.detail-footer-inner {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

.quantity-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.quantity-label {
  font-size: 28rpx;
  color: var(--gray-600);
}

.quantity-control {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--gray-200);
  border-radius: 16rpx;
  overflow: hidden;
}

.quantity-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gray-50);
}

.quantity-value {
  width: 80rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.footer-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.cart-icon-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--accent);
  border-radius: 20rpx;
  background: var(--amber-50);
}

.add-to-cart-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--accent), var(--accent-dark));
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.28);
}

.add-to-cart-btn.disabled {
  background: var(--gray-300);
  box-shadow: none;
  pointer-events: none;
}

.btn {
  display: inline-block;
  padding: 18rpx 40rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-secondary {
  background: var(--accent);
  color: #fff;
  margin-top: 32rpx;
}
