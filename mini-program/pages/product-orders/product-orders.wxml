<wxs src="../../utils/format.wxs" module="fmt" />
<view class="orders-page">
  <view class="orders-header">
    <view class="header-back" bindtap="goBack">
      <mbs-icon name="arrowLeft" size="36" color="var(--text-primary)" />
    </view>
    <view class="header-title">我的商品订单</view>
    <view class="header-spacer"></view>
  </view>

  <view wx:if="{{loading}}" class="orders-empty">
    <view class="empty-text">加载中...</view>
  </view>

  <view wx:if="{{!loading && orders.length === 0}}" class="orders-empty">
    <mbs-icon name="shoppingBag" size="96" color="var(--text-tertiary)" />
    <view class="empty-text">暂无商品订单</view>
    <view class="btn btn-secondary" bindtap="goToProducts">去逛逛</view>
  </view>

  <view wx:if="{{!loading && orders.length > 0}}" class="container orders-container">
    <view wx:for="{{orders}}" wx:key="id" class="order-card card">
      <view class="order-header">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status status-{{item.status}}">{{statusLabels[item.status]}}</text>
      </view>

      <view class="order-items">
        <view wx:for="{{item.items}}" wx:for-item="goods" wx:key="id" class="order-item">
          <image wx:if="{{goods.image}}" class="order-item-image" src="{{goods.image}}" mode="aspectFill" />
          <view wx:else class="order-item-image-placeholder">
            <mbs-icon name="shoppingBag" size="40" color="var(--text-tertiary)" />
          </view>
          <view class="order-item-info">
              <view class="order-item-name">{{goods.name}}</view>
              <view class="order-item-spec">¥{{fmt.formatMoney(goods.price)}} × {{goods.quantity}}</view>
            </view>
            <view class="order-item-total">¥{{fmt.formatMoney(goods.totalAmount)}}</view>
        </view>
      </view>

      <view class="order-footer">
        <text class="order-time">{{fmt.formatDateTime(item.createdAt)}}</text>
        <view class="order-total">
          合计：<text class="order-total-price">¥{{fmt.formatMoney(item.payableAmount)}}</text>
        </view>
      </view>

      <view wx:if="{{item.pickupCode}}" class="pickup-code">
        <text>自提码：</text>
        <text class="pickup-code-value">{{item.pickupCode}}</text>
      </view>
    </view>
  </view>

  <login-modal visible="{{showLogin}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
