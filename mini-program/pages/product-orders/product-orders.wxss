/* Product Orders —— 与 H5 ProductOrders.tsx 视觉语言对齐 */

.orders-page {
  min-height: 100vh;
  background: var(--bg);
}

/* ===== 自定义头部 ===== */
.order-header-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.order-header-btn:active {
  background: var(--gray-100);
}

.order-header-placeholder {
  width: 72rpx;
}

/* ===== 状态筛选 Tabs ===== */
.order-filter {
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--gray-100);
}

/* ===== 订单列表 ===== */
.order-list {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom, 0));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ===== 订单卡片 ===== */
.order-card {
  background: var(--card-bg);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid var(--gray-100);
}

/* 卡片顶部 */
.order-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.order-no {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.order-status-badge {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  font-weight: 600;
}

/* 状态徽章颜色 —— 与 H5 tailwind 映射 */
.status-pending    { background: var(--amber-50);  color: var(--accent-dark); }
.status-paid       { background: var(--blue-50);   color: var(--blue-700); }
.status-preparing  { background: var(--yellow-100); color: var(--amber-600); }
.status-ready      { background: var(--amber-100); color: var(--accent-dark); }
.status-shipped    { background: var(--indigo-50, #EEF2FF); color: var(--indigo-600, #4F46E5); }
.status-completed  { background: var(--green-50);  color: var(--green-600); }
.status-cancelled  { background: var(--gray-100);  color: var(--gray-600); }
.status-refunded   { background: var(--red-50);   color: var(--red-600); }
.status-refunding  { background: var(--red-50);   color: var(--red-500); }

/* 商品预览 —— 缩略图横排 */
.order-items-preview {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.order-item-thumb {
  width: 104rpx;
  height: 104rpx;
  border-radius: 16rpx;
  background: var(--gray-100);
  flex-shrink: 0;
  object-fit: cover;
}

.order-item-thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-item-more {
  width: 104rpx;
  height: 104rpx;
  border-radius: 16rpx;
  background: var(--gray-100);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 600;
  flex-shrink: 0;
}

/* 商品名称 */
.order-items-names {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 20rpx;
}

.order-item-name {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 卡片底部 */
.order-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--gray-100);
  margin-bottom: 24rpx;
}

.order-total {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.order-total-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.order-total-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--danger);
}

.order-item-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

/* 操作按钮 */
.order-card-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
}

.order-action-btn {
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.order-action-btn-outline {
  background: var(--amber-50);
  color: var(--accent-dark);
  border: 2rpx solid var(--amber-200);
}

.order-action-btn-block {
  width: 100%;
}

/* ===== 空状态（覆盖 app.scss 基础样式） ===== */
.order-empty-btn {
  margin-top: 32rpx;
}

/* ===== 详情弹窗 ===== */
.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 28rpx;
}

.detail-label {
  color: var(--text-secondary);
  font-size: 26rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.detail-value {
  color: var(--text-primary);
  font-size: 28rpx;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
  word-break: break-all;
}

.detail-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin: 32rpx 0 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--gray-100);
}

/* 详情商品项 */
.detail-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--gray-50);
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-item-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background: var(--gray-100);
  flex-shrink: 0;
  object-fit: cover;
}

.detail-item-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-item-info {
  flex: 1;
  min-width: 0;
}

.detail-item-name {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.detail-item-spec {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.detail-item-total {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
}

/* 自提码 */
.pickup-code-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent-dark);
  letter-spacing: 4rpx;
}

/* 合计区 */
.detail-summary {
  margin-top: 32rpx;
  padding: 24rpx;
  background: var(--gray-50);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
}

.detail-summary-label {
  color: var(--text-secondary);
}

.detail-summary-value {
  color: var(--text-primary);
  font-weight: 500;
}

.detail-summary-total {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--gray-200);
  margin-top: 4rpx;
}

.detail-summary-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--danger);
}

/* 退款弹窗 */
.refund-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--danger);
}

.refund-section-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
  margin: 24rpx 0 12rpx;
}

.refund-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  background: var(--gray-50);
  border: 2rpx solid var(--gray-200);
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  font-family: inherit;
}

.refund-textarea:focus {
  border-color: var(--primary);
  background: #fff;
}

/* 按钮禁用状态 */
.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ===== 发货相关样式 ===== */

/* 已发货状态徽章 */
.status-shipped {
  background: var(--indigo-50, #EEF2FF);
  color: var(--indigo-600, #4F46E5);
}

/* 订单卡片 - 发货信息条 */
.order-shipping-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: var(--indigo-50, #EEF2FF);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.order-shipping-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.order-shipping-company {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--indigo-700, #4338CA);
}

.order-shipping-no {
  font-size: 24rpx;
  color: var(--indigo-500, #6366F1);
}

/* 详情 - 物流信息区块 */
.detail-shipping-section {
  margin: 24rpx 0;
}

.detail-shipping-card {
  background: var(--indigo-50, #EEF2FF);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 16rpx;
}

.detail-shipping-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

/* 详情弹窗底部按钮区 */
.detail-modal-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: flex-end;
}

.detail-modal-footer .btn {
  flex: 0 0 auto;
  min-width: 160rpx;
}

/* ===== 物流轨迹弹窗 ===== */
.tracking-modal {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.tracking-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 24rpx;
}

.tracking-loading-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.tracking-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 24rpx;
}

.tracking-empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.tracking-header {
  margin-bottom: 32rpx;
}

.tracking-company {
  background: var(--indigo-50, #EEF2FF);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tracking-company-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--indigo-700, #4338CA);
}

.tracking-company-no {
  font-size: 26rpx;
  color: var(--indigo-500, #6366F1);
}

/* 物流时间线 */
.timeline {
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  gap: 24rpx;
  position: relative;
  padding-bottom: 32rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--gray-300);
  flex-shrink: 0;
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}

.timeline-dot-active {
  background: var(--indigo-500, #6366F1);
  width: 24rpx;
  height: 24rpx;
  margin-top: 6rpx;
}

.timeline-line {
  position: absolute;
  left: 9rpx;
  top: 32rpx;
  width: 2rpx;
  height: calc(100% - 20rpx);
  background: var(--gray-200);
}

.timeline-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-left: 8rpx;
}

.timeline-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
  line-height: 1.5;
}

.timeline-desc-active {
  color: var(--text-primary);
  font-weight: 600;
}

.timeline-time {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.timeline-location {
  font-size: 24rpx;
  color: var(--text-tertiary);
}
