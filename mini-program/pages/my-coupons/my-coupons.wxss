.coupon-page {
  min-height: 100vh;
  background: var(--gray-50);
  padding-bottom: env(safe-area-inset-bottom, 0);
}

/* ===== Sticky Header ===== */
.coupon-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.coupon-header__back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.coupon-header__back:active {
  background: var(--gray-100);
}

.coupon-header__title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gray-800);
}

.coupon-header__spacer {
  width: 72rpx;
}

/* ===== Tab Bar ===== */
.coupon-tabs {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--gray-100);
}

.coupon-tab {
  flex-shrink: 0;
  padding: 16rpx 36rpx;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--gray-600);
  background: var(--gray-100);
  transition: all 0.2s ease;
}

.coupon-tab--active {
  background: linear-gradient(135deg, var(--accent), var(--accent-dark));
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(245, 158, 11, 0.3);
}

/* ===== Body ===== */
.coupon-body {
  padding: 32rpx;
}

/* ===== Loading ===== */
.coupon-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
  gap: 24rpx;
}

.coupon-loading__spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--gray-200);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: coupon-spin 0.8s linear infinite;
}

@keyframes coupon-spin {
  to { transform: rotate(360deg); }
}

.coupon-loading__text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ===== Empty State ===== */
.coupon-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
}

.coupon-empty__icon {
  width: 200rpx;
  height: 200rpx;
  background: var(--gray-100);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.coupon-empty__text {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

.coupon-empty__btn {
  min-width: 240rpx;
}

/* ===== Coupon Card ===== */
.coupon-card {
  display: flex;
  align-items: stretch;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid var(--gray-100);
}

.coupon-card--usable {
  border-color: rgba(245, 158, 11, 0.15);
}

.coupon-card--disabled {
  opacity: 0.75;
}

/* Left colored stub */
.coupon-card__stub {
  width: 200rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #ff6b35, #f7931e);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 24rpx 16rpx;
}

.coupon-card--disabled .coupon-card__stub {
  background: linear-gradient(135deg, var(--gray-400), var(--gray-500));
}

.coupon-card__stub-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  line-height: 1.1;
}

/* Decorative notches on stub */
.coupon-card__stub::before,
.coupon-card__stub::after {
  content: '';
  position: absolute;
  right: -12rpx;
  width: 24rpx;
  height: 24rpx;
  background: var(--gray-50);
  border-radius: 50%;
}

.coupon-card__stub::before {
  top: -12rpx;
}

.coupon-card__stub::after {
  bottom: -12rpx;
}

/* Dashed divider */
.coupon-card__divider {
  width: 0;
  border-left: 2rpx dashed var(--gray-300);
  margin: 24rpx 0;
}

/* Card body */
.coupon-card__body {
  flex: 1;
  min-width: 0;
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.coupon-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.coupon-card__name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-card__status {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 9999rpx;
  font-weight: 500;
}

.coupon-card__threshold {
  font-size: 26rpx;
  color: var(--accent-dark);
  font-weight: 500;
}

.coupon-card__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.coupon-card__scope {
  flex-shrink: 0;
}

.coupon-card__dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--gray-300);
  flex-shrink: 0;
}

.coupon-card__expiry {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-card__used-at {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.coupon-card__action-row {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}

.coupon-card__action {
  padding: 14rpx 36rpx;
  border-radius: 9999rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: linear-gradient(135deg, var(--accent), var(--accent-dark));
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.25);
  transition: opacity 0.15s;
}

.coupon-card__action--hover {
  opacity: 0.8;
}

.coupon-card__action:active {
  opacity: 0.85;
}

.coupon-card__action--disabled {
  background: var(--gray-100);
  color: var(--text-tertiary);
  box-shadow: none;
  font-weight: 500;
}

/* ===== Status Badge Variants ===== */
.status-unused {
  color: var(--accent);
  background: var(--amber-50);
}

.status-used {
  color: var(--success);
  background: var(--green-50);
}

.status-expired {
  color: var(--gray-500);
  background: var(--gray-100);
}

.status-cancelled {
  color: var(--danger);
  background: var(--red-50);
}
