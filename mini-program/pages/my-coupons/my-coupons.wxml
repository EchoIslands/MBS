<view class="my-coupons-page">
  <view class="page-header">
    <view class="header-back" bindtap="goBack">
      <mbs-icon name="arrowLeft" size="36" color="var(--text-primary)" />
    </view>
    <view class="header-title">我的优惠券</view>
    <view class="header-spacer"></view>
  </view>

  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      data-tab="{{item.key}}"
      class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}"
      bindtap="onTabTap"
    >
      {{item.label}}
    </view>
  </view>

  <view class="coupon-list">
    <view wx:if="{{loading}}" class="loading-state">加载中...</view>

    <block wx:elif="{{coupons.length === 0}}">
      <view class="empty-state">
        <mbs-icon name="ticket" size="80" color="var(--text-tertiary)" />
        <view class="empty-text">暂无{{activeTabLabel}}优惠券</view>
        <view class="btn btn-primary btn-small" style="margin-top: 24rpx;" bindtap="goToClaim">去领券</view>
      </view>
    </block>

    <block wx:else>
      <view
        wx:for="{{coupons}}"
        wx:key="id"
        class="coupon-card {{item.isUsable ? 'coupon-card-active' : 'coupon-card-disabled'}}"
      >
        <view class="coupon-main">
          <view class="coupon-value">{{item.valueText}}</view>
          <view class="coupon-info">
            <view class="coupon-name">{{item.coupon.name || '优惠券'}}</view>
            <view wx:if="{{item.coupon.minOrderAmount}}" class="coupon-threshold">满{{item.coupon.minOrderAmount}}元可用</view>
            <view class="coupon-scope">{{item.scopeText}} · 有效期至 {{item.coupon.endAt}}</view>
            <view wx:if="{{item.usedAt}}" class="coupon-used-at">使用时间：{{item.usedAt}}</view>
          </view>
        </view>
        <view class="coupon-side">
          <view class="coupon-status {{item.statusClass}}">{{item.statusText}}</view>
          <button
            wx:if="{{item.isUsable}}"
            class="btn btn-primary btn-small"
            data-coupon="{{item.coupon}}"
            bindtap="onUseTap"
          >去使用</button>
        </view>
      </view>
    </block>
  </view>
</view>
