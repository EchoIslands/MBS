<view class="recharge-page">
  <view class="recharge-header">
    <view class="recharge-header__back" bindtap="goBack"><mbs-icon name="arrowLeft" size="36" color="var(--gray-800)" /></view>
    <view class="recharge-header__title">储值余额</view>
    <view class="recharge-header__spacer"></view>
  </view>
  <view class="recharge-body">
    <view class="balance-card">
      <view class="balance-label">当前储值余额</view>
      <view class="balance-value">¥{{balanceText}}</view>
    </view>
    <view class="section-title">充值办理说明</view>
    <view class="recharge-tips">
      <view class="tip-item">线上自助充值暂未开放，请联系门店办理。</view>
      <view class="tip-item">已有储值余额可正常使用。</view>
    </view>
  </view>
</view>
