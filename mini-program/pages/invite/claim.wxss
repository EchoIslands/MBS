.claim-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, #f8f9fb 100%);
  padding: 32rpx;
  box-sizing: border-box;
}

.claim-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  color: #6b7280;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e5e7eb;
  border-top-color: #4f46e5;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.claim-card,
.claim-success,
.claim-error {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.claim-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.referrer-name {
  font-size: 32rpx;
  color: #4f46e5;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.claim-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
}

.coupon-card {
  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  color: #fff;
  text-align: center;
  margin-bottom: 48rpx;
}

.coupon-main {
  margin-bottom: 16rpx;
}

.coupon-value {
  font-size: 72rpx;
  font-weight: 700;
  line-height: 1;
}

.coupon-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 12rpx;
}

.coupon-condition {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.coupon-valid {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  height: 88rpx;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1f2937;
}

.already-claimed {
  text-align: center;
  color: #ef4444;
  font-size: 30rpx;
  padding: 40rpx 0;
}

.claim-success {
  text-align: center;
}

.success-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.success-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 32rpx;
}

.coupon-card-mini {
  background: #f3f4f6;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
}

.claim-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ef4444;
  gap: 24rpx;
}

.btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}
