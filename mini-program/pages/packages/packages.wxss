.packages-page {
  min-height: 100vh;
  background: #f9fafb;
  padding: 24rpx;
  box-sizing: border-box;
}

.packages-header {
  margin-bottom: 24rpx;
}

.packages-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.packages-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.packages-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.packages-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.packages-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.packages-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #111827;
}

.packages-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.status-active {
  background: #dcfce7;
  color: #166534;
}

.status-used {
  background: #f3f4f6;
  color: #4b5563;
}

.status-expired {
  background: #fee2e2;
  color: #991b1b;
}

.packages-info {
  display: flex;
  gap: 48rpx;
}

.packages-info-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.packages-info-label {
  font-size: 24rpx;
  color: #6b7280;
}

.packages-info-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.packages-hint {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
  font-size: 24rpx;
  color: #059669;
}

.packages-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.packages-empty-text {
  font-size: 30rpx;
  color: #374151;
  margin-bottom: 16rpx;
}

.packages-empty-hint {
  font-size: 26rpx;
  color: #9ca3af;
  margin-bottom: 32rpx;
}

.packages-btn {
  background: #2563eb;
  color: #ffffff;
  font-size: 28rpx;
  padding: 20rpx 48rpx;
  border-radius: 999rpx;
}
