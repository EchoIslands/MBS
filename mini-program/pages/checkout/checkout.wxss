/* Checkout page — H5 visual language */

.checkout-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom, 0));
}

/* 1) Top nav */
.checkout-nav {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(24rpx + env(safe-area-inset-top, 0)) 24rpx 24rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.checkout-nav-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--gray-100);
}

.checkout-nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--gray-800);
}

.checkout-nav-spacer {
  width: 64rpx;
}

/* 2) Header with gradient */
.checkout-hero {
  position: relative;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 60%, #1e3a8a 100%);
  padding: 48rpx 32rpx 72rpx;
  overflow: hidden;
}

.checkout-hero-decor {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

.checkout-hero-decor-1 {
  width: 300rpx;
  height: 300rpx;
  top: -120rpx;
  right: -60rpx;
}

.checkout-hero-decor-2 {
  width: 200rpx;
  height: 200rpx;
  bottom: -80rpx;
  left: -40rpx;
}

.checkout-hero-inner {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.checkout-hero-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkout-hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.checkout-hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

/* Body */
.checkout-body {
  position: relative;
  z-index: 2;
  margin-top: -48rpx;
  padding: 0 24rpx;
}

.checkout-state-card {
  text-align: center;
  padding: 80rpx 48rpx;
}

.checkout-state-error {
  color: var(--danger);
  font-size: 28rpx;
  margin-bottom: 32rpx;
}

/* 3) Booking card */
.checkout-booking-card {
  margin-bottom: 24rpx;
}

.checkout-booking-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.checkout-booking-head-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.checkout-booking-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.checkout-booking-list {
  display: flex;
  flex-direction: column;
}

.checkout-booking-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--gray-100);
}

.checkout-booking-row:last-child {
  border-bottom: none;
}

.checkout-booking-row-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.checkout-booking-row-value {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  text-align: right;
  max-width: 60%;
}

.checkout-queue-value {
  color: var(--primary);
  font-weight: 700;
}

/* 4) VIP member card */
.checkout-vip-card {
  position: relative;
  margin: 0 32rpx 24rpx;
  padding: 40rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--amber-500) 0%, #f97316 50%, #ea580c 100%);
  color: #fff;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(245, 158, 11, 0.28);
}

.checkout-vip-decor {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  pointer-events: none;
}

.checkout-vip-decor-1 {
  width: 260rpx;
  height: 260rpx;
  top: -100rpx;
  right: -60rpx;
}

.checkout-vip-decor-2 {
  width: 160rpx;
  height: 160rpx;
  bottom: -60rpx;
  right: 120rpx;
}

.checkout-vip-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.checkout-vip-user {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.checkout-vip-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
}

.checkout-vip-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.checkout-vip-level {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.95);
}

.checkout-vip-stored {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

.checkout-vip-stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 24rpx;
  backdrop-filter: blur(8rpx);
}

.checkout-vip-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.checkout-vip-stat-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.checkout-vip-stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}

.checkout-vip-stat-divider {
  width: 2rpx;
  background: rgba(255, 255, 255, 0.25);
  margin: 0 24rpx;
}

/* Price card */
.checkout-price-card {
  margin-bottom: 24rpx;
}

.checkout-price-rows {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx;
  background: var(--gray-50);
  border-radius: 24rpx;
}

.checkout-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
}

.checkout-price-label {
  color: var(--text-secondary);
}

.checkout-price-value {
  font-weight: 500;
  color: var(--text-primary);
}

.checkout-price-original {
  color: var(--text-tertiary);
  text-decoration: line-through;
  font-size: 26rpx;
}

.checkout-price-discount {
  color: var(--accent);
}

.checkout-price-total {
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--gray-200);
  margin-top: 4rpx;
}

.checkout-price-final {
  color: var(--accent);
  font-size: 36rpx;
  font-weight: 700;
}

.checkout-discount-hint {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--amber-50);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: var(--accent-dark);
  line-height: 1.5;
}

/* Login tip */
.checkout-login-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.checkout-login-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--gray-100);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkout-login-info {
  flex: 1;
  min-width: 0;
}

.checkout-login-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.checkout-login-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.checkout-login-btn {
  flex-shrink: 0;
  padding: 16rpx 36rpx;
}

/* 5) Payment */
.checkout-payment-card {
  margin-bottom: 24rpx;
}

.checkout-payment-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.checkout-payment-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  background: var(--gray-50);
  border-radius: 24rpx;
  border: 1rpx solid var(--gray-100);
}

.checkout-payment-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkout-payment-icon-balance {
  background: linear-gradient(135deg, var(--primary-light), var(--primary));
}

.checkout-payment-icon-store {
  background: linear-gradient(135deg, var(--green-500), var(--green-600));
}

.checkout-payment-info {
  flex: 1;
  min-width: 0;
}

.checkout-payment-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.checkout-payment-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.checkout-payment-tag {
  padding: 8rpx 20rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: var(--gray-200);
  color: var(--text-secondary);
  flex-shrink: 0;
}

.checkout-payment-tag-active {
  background: var(--blue-100);
  color: var(--primary);
}

/* 6) Notice */
.checkout-notice-card {
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, var(--amber-50), #fff);
  border: 1rpx solid var(--amber-100);
}

.checkout-notice-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.checkout-notice-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent-dark);
}

.checkout-notice-body {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

/* 7) Fixed bottom bar */
.checkout-bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.checkout-bottom-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.checkout-bottom-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.checkout-bottom-price {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.checkout-bottom-original {
  font-size: 26rpx;
  color: var(--text-tertiary);
  text-decoration: line-through;
}

.checkout-bottom-actual {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--accent);
  line-height: 1.1;
}

.checkout-bottom-btn {
  flex: 1;
  max-width: 360rpx;
  height: 96rpx;
}
