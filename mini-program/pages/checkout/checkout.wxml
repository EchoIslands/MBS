<wxs src="../../utils/format.wxs" module="fmt" />
<view class="checkout-page">
  <!-- 1) Top nav -->
  <view class="checkout-nav" bindtap="goBack">
    <view class="checkout-nav-btn">
      <mbs-icon name="arrowLeft" size="36" color="var(--gray-800)" />
    </view>
    <view class="checkout-nav-title">结算</view>
    <view class="checkout-nav-spacer"></view>
  </view>

  <!-- 2) Header with gradient -->
  <view class="checkout-hero">
    <view class="checkout-hero-decor checkout-hero-decor-1"></view>
    <view class="checkout-hero-decor checkout-hero-decor-2"></view>
    <view class="checkout-hero-inner">
      <view class="checkout-hero-icon">
        <mbs-icon name="creditCard" size="48" color="#fff" />
      </view>
      <view class="checkout-hero-text">
        <view class="checkout-hero-title">支付结算</view>
        <view class="checkout-hero-sub">到店服务完成后由店员确认收款</view>
      </view>
    </view>
  </view>

  <view class="checkout-body">
    <!-- loading -->
    <view wx:if="{{loading}}" class="card checkout-state-card">
      <view class="empty-icon"><mbs-icon name="clock" size="56" color="var(--text-tertiary)" /></view>
      <view class="empty-text">预约信息加载中...</view>
    </view>

    <!-- error -->
    <view wx:elif="{{error}}" class="card checkout-state-card">
      <view class="checkout-state-error">{{error}}</view>
      <view class="btn btn-secondary" bindtap="loadBooking">重新加载</view>
    </view>

    <!-- no booking -->
    <view wx:elif="{{!booking}}" class="card checkout-state-card">
      <view class="empty-icon"><mbs-icon name="calendar" size="56" color="var(--text-tertiary)" /></view>
      <view class="empty-text">请选择要结算的预约</view>
      <view class="btn btn-primary" bindtap="onViewProfile">查看我的预约</view>
    </view>

    <block wx:else>
      <!-- 3) Booking info card -->
      <view class="card checkout-booking-card">
        <view class="checkout-booking-head">
          <view class="checkout-booking-head-left">
            <mbs-icon name="scissors" size="32" color="var(--accent)" />
            <text class="checkout-booking-title">预约信息</text>
          </view>
          <mbs-status-badge status="{{booking.status}}" />
        </view>

        <view class="checkout-booking-list">
          <view class="checkout-booking-row">
            <view class="checkout-booking-row-label">
              <mbs-icon name="scissors" size="22" color="var(--text-tertiary)" />
              <text>服务项目</text>
            </view>
            <text class="checkout-booking-row-value">{{booking.serviceName}}</text>
          </view>
          <view class="checkout-booking-row">
            <view class="checkout-booking-row-label">
              <mbs-icon name="calendar" size="22" color="var(--text-tertiary)" />
              <text>预约时间</text>
            </view>
            <text class="checkout-booking-row-value">{{fmt.formatDateTime(booking.scheduledTime)}}</text>
          </view>
          <view class="checkout-booking-row">
            <view class="checkout-booking-row-label">
              <mbs-icon name="user" size="22" color="var(--text-tertiary)" />
              <text>发型师</text>
            </view>
            <text class="checkout-booking-row-value">{{booking.stylistName || booking.barberName || '待安排'}}</text>
          </view>
          <view class="checkout-booking-row">
            <view class="checkout-booking-row-label">
              <mbs-icon name="mapPin" size="22" color="var(--text-tertiary)" />
              <text>店铺</text>
            </view>
            <text class="checkout-booking-row-value">{{booking.shopName || '门店'}}</text>
          </view>
          <view wx:if="{{booking.queueNumber}}" class="checkout-booking-row">
            <view class="checkout-booking-row-label">
              <mbs-icon name="clock" size="22" color="var(--text-tertiary)" />
              <text>排队号</text>
            </view>
            <text class="checkout-booking-row-value checkout-queue-value">#{{booking.queueNumber}}</text>
          </view>
        </view>
      </view>

      <!-- 4) VIP member card -->
      <view wx:if="{{customer}}" class="checkout-vip-card">
        <view class="checkout-vip-decor checkout-vip-decor-1"></view>
        <view class="checkout-vip-decor checkout-vip-decor-2"></view>

        <view class="checkout-vip-head">
          <view class="checkout-vip-user">
            <view class="checkout-vip-avatar">
              <mbs-icon name="user" size="40" color="#fff" />
            </view>
            <view class="checkout-vip-name-block">
              <view class="checkout-vip-name">{{customer.name || '尊贵的顾客'}}</view>
              <view class="checkout-vip-level">
                <mbs-icon name="crown" size="16" color="#fff" />
                <text>{{fmt.getPurchaseVIPLabel(purchaseLevel)}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{storedLevel !== StoredValueLevel.NONE}}" class="checkout-vip-stored">
            <mbs-icon name="wallet" size="16" color="#fff" />
            <text>{{fmt.getStoredValueLabel(storedLevel)}}</text>
          </view>
        </view>

        <view class="checkout-vip-stats">
          <view class="checkout-vip-stat">
            <view class="checkout-vip-stat-label">
              <mbs-icon name="sparkles" size="16" color="rgba(255,255,255,0.85)" />
              当前折扣
            </view>
            <view class="checkout-vip-stat-value">{{fmt.formatDiscount(effectiveDiscount)}} 折</view>
          </view>
          <view class="checkout-vip-stat-divider"></view>
          <view class="checkout-vip-stat">
            <view class="checkout-vip-stat-label">
              <mbs-icon name="wallet" size="16" color="rgba(255,255,255,0.85)" />
              储值余额
            </view>
            <view class="checkout-vip-stat-value">¥{{balanceStr}}</view>
          </view>
        </view>
      </view>

      <!-- VIP price details card -->
      <view wx:if="{{customer}}" class="card checkout-price-card">
        <view class="card-title">
          <mbs-icon name="creditCard" size="32" color="var(--primary)" />
          <text>价格明细</text>
        </view>

        <view class="checkout-price-rows">
          <view class="checkout-price-row">
            <text class="checkout-price-label">服务原价</text>
            <text class="checkout-price-value {{hasDiscount ? 'checkout-price-original' : ''}}">¥{{originalPriceStr}}</text>
          </view>
          <view wx:if="{{hasPurchaseDiscount}}" class="checkout-price-row">
            <text class="checkout-price-label">{{fmt.getPurchaseVIPLabel(purchaseLevel)}} ×{{purchaseVIPDiscountStr}} 折</text>
            <text class="checkout-price-value checkout-price-discount">-¥{{vipDiscountAmountStr}}</text>
          </view>
          <view wx:if="{{hasStoredDiscount}}" class="checkout-price-row">
            <text class="checkout-price-label">{{fmt.getStoredValueLabel(storedLevel)}} 折上折 ×{{storedValueDiscountStr}} 折</text>
            <text class="checkout-price-value checkout-price-discount">-¥{{storedDiscountAmountStr}}</text>
          </view>
          <view wx:if="{{isStockholderDiscount}}" class="checkout-price-row">
            <text class="checkout-price-label">股东折扣</text>
            <text class="checkout-price-value checkout-price-discount">已享股东价</text>
          </view>
          <view wx:if="{{hasDiscount}}" class="checkout-price-row checkout-price-total">
            <text class="checkout-price-label">预计实付</text>
            <text class="checkout-price-value checkout-price-final">¥{{memberPriceStr}}</text>
          </view>
        </view>

        <view wx:if="{{hasDiscount}}" class="checkout-discount-hint">
          <mbs-icon name="sparkles" size="22" color="var(--accent-dark)" />
          <text wx:if="{{isStockholderDiscount}}">股东权益已生效，到店结算时自动应用</text>
          <text wx:else>当前综合折扣 {{effectiveDiscountStr}} 折，到店结算时自动生效</text>
        </view>
      </view>

      <!-- 4b) Login tip card -->
      <view wx:if="{{!customer}}" class="card checkout-login-card">
        <view class="checkout-login-icon">
          <mbs-icon name="user" size="48" color="var(--primary)" />
        </view>
        <view class="checkout-login-info">
          <view class="checkout-login-title">登录后查看会员价</view>
          <view class="checkout-login-desc">开通 VIP 或储值卡可享受专属折扣</view>
        </view>
        <view class="btn btn-secondary checkout-login-btn" bindtap="openLogin">登录</view>
      </view>

      <!-- 5) Payment method list -->
      <view class="card checkout-payment-card">
        <view class="card-title">
          <mbs-icon name="creditCard" size="32" color="var(--primary)" />
          <text>支付方式</text>
        </view>

        <view class="checkout-payment-list">
          <view class="checkout-payment-item">
            <view class="checkout-payment-icon checkout-payment-icon-balance">
              <mbs-icon name="wallet" size="28" color="#fff" />
            </view>
            <view class="checkout-payment-info">
              <view class="checkout-payment-name">储值余额支付</view>
              <view class="checkout-payment-desc">
                <text wx:if="{{balance > 0}}">可用余额 ¥{{balanceStr}}</text>
                <text wx:else>当前无储值余额</text>
              </view>
            </view>
            <view class="checkout-payment-tag {{balance > 0 ? 'checkout-payment-tag-active' : ''}}">
              {{balance > 0 ? '可用' : '待充值'}}
            </view>
          </view>

          <view class="checkout-payment-item">
            <view class="checkout-payment-icon checkout-payment-icon-store">
              <mbs-icon name="mapPin" size="28" color="#fff" />
            </view>
            <view class="checkout-payment-info">
              <view class="checkout-payment-name">到店自提</view>
              <view class="checkout-payment-desc">到店后由店员扫码或收银台完成结算</view>
            </view>
            <view class="checkout-payment-tag checkout-payment-tag-active">推荐</view>
          </view>
        </view>
      </view>

      <!-- 6) Notice card -->
      <view class="card checkout-notice-card">
        <view class="checkout-notice-head">
          <mbs-icon name="alertCircle" size="28" color="var(--accent)" />
          <text class="checkout-notice-title">温馨提示</text>
        </view>
        <view class="checkout-notice-body">
          当前页面仅用于查看预约与预估金额。实际结算、收款由门店店员在确认服务完成后操作，您也可到店后出示会员码完成支付。
        </view>
      </view>
    </block>
  </view>

  <!-- 7) Fixed bottom bar -->
  <view wx:if="{{booking}}" class="fixed-bottom-bar checkout-bottom-bar">
    <view class="checkout-bottom-left">
      <view class="checkout-bottom-label">
        <mbs-icon name="creditCard" size="22" color="var(--text-tertiary)" />
        <text>预计实付</text>
      </view>
      <view class="checkout-bottom-price">
        <text wx:if="{{hasDiscount}}" class="checkout-bottom-original">¥{{originalPriceStr}}</text>
        <text class="checkout-bottom-actual">¥{{memberPriceStr}}</text>
      </view>
    </view>
    <view class="btn btn-blue checkout-bottom-btn" bindtap="onViewQueue">
      <mbs-icon name="clock" size="28" color="#fff" />
      <text>查看排队</text>
    </view>
  </view>

  <login-modal visible="{{showLogin}}" bind:close="onLoginClose" bind:success="onLoginSuccess" />
</view>
